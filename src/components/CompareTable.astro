---
// Tabla comparativa limpia, con scroll propio en móvil y la primera columna fija.
import { producto, urlFicha } from '../data/productos';
import { unidades } from '../lib/texto';

interface Props { columnas: string[]; filas: { slug: string; valores: string[] }[]; caption: string }
const { columnas, filas, caption } = Astro.props;
---
<div class="ct" data-rv>
  <div class="ct__scroll" tabindex="0" role="region" aria-label={caption}>
    <table class="ct__table">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr><th scope="col">Modelo</th>{columnas.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {filas.map((f) => {
          const p = producto(f.slug);
          return (
            <tr>
              <th scope="row"><a href={urlFicha(p)}>{p.nombre}</a><span>{p.marca}</span></th>
              {f.valores.map((v) => <td class:list={{ 'is-na': v === 'Consultar' }}>{unidades(v)}</td>)}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
<style is:global>
  .ct { max-width: 1200px; margin: 0 auto; }
  .ct__scroll { overflow-x: auto; border-radius: var(--r-lg); background: #FFF; box-shadow: inset 0 0 0 1px var(--line), var(--shadow); overscroll-behavior-x: contain; }
  .ct__scroll:focus-visible { outline-offset: 2px; }
  .ct__table { width: 100%; min-width: 820px; border-collapse: separate; border-spacing: 0; font-size: .9375rem; }
  .ct__table th, .ct__table td { padding: 14px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); line-height: 1.4; }
  .ct__table thead th { position: sticky; top: 0; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); background: #FFF; }
  .ct__table tbody tr:last-child > * { border-bottom: 0; }
  .ct__table tbody th { position: sticky; left: 0; z-index: 1; min-width: 150px; background: #FFF; box-shadow: 1px 0 0 var(--line); }
  .ct__table tbody th a { display: block; margin: -12px 0 -10px; padding: 12px 0 10px; font-weight: 560; color: var(--ink); text-decoration: none; letter-spacing: -.01em; }
  .ct__table tbody th a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .ct__table tbody th span { display: block; font-size: .8125rem; font-weight: 400; color: var(--ink-3); }
  .ct__table td { color: var(--ink-2); }
  .ct__table td.is-na { color: var(--ink-3); font-style: italic; }
  .ct__table tbody tr:hover > * { background: #F8FAFB; }
</style>
