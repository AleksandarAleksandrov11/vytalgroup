---
// Preguntas frecuentes en acordeón (mismo diseño que la landing). El FAQPage de JSON-LD lo añade la
// página con los mismos datos, para que sea idéntico a lo visible.
import type { Faq } from '../data/categorias';
import { acento, enlaces } from '../lib/texto';
import { wa } from '../data/empresa';

interface Props { faqs: Faq[]; titulo?: string; id?: string; cta?: boolean; fondo?: 'niebla' | 'blanco' }
const { faqs, titulo = 'Lo que *nos preguntáis.*', id = 'dudas', cta = true, fondo = 'niebla' } = Astro.props;
---
<section class:list={['sec faq', fondo === 'blanco' ? 'sec--white' : 'sec--mist']} id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap wrap--narrow">
    <h2 class="h2 faq__title" id={`${id}-title`} data-lines set:html={acento(titulo)} />
    <div class="acc" data-acc data-rv>
      {faqs.map((f, i) => (
        <div class="acc__item">
          <h3 class="acc__h"><button class="acc__btn" type="button" id={`${id}-q${i}`} aria-expanded="false" aria-controls={`${id}-a${i}`}>{f.q}<span class="acc__icon" aria-hidden="true"></span></button></h3>
          <div class="acc__panel" id={`${id}-a${i}`} role="region" aria-labelledby={`${id}-q${i}`} hidden><p set:html={enlaces(f.a)} /></div>
        </div>
      ))}
    </div>
    {cta && (
      <div class="sec__cta faq__more" data-rv>
        <a class="link" href={wa('Hola, vengo de la web y tengo una duda: ')} target="_blank" rel="noopener" data-origen="dudas">¿Otra duda? Escríbenos por WhatsApp</a>
      </div>
    )}
  </div>
</section>
<style is:global>
  .faq__title { margin-bottom: 36px; text-align: center; }
  @media (min-width: 900px) { .faq__title { margin-bottom: 56px; } }
  .acc { border-top: 1px solid var(--line-2); }
  .acc__item { position: relative; background: inherit; border-bottom: 1px solid var(--line-2); }
  .acc__h { font: inherit; }
  .acc__btn { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; min-height: 72px; padding: 18px 0; border: 0; background: none; text-align: left; font-size: clamp(1.0625rem, 1rem + .4vw, 1.3125rem); font-weight: 500; line-height: 1.3; letter-spacing: -.015em; cursor: pointer; color: var(--ink); }
  .acc__icon { position: relative; flex: none; width: 34px; height: 34px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-2); transition: transform .45s var(--ease), background-color .25s ease, color .25s ease, box-shadow .25s ease; }
  .acc__icon::before, .acc__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; margin: -.75px 0 0 -6px; border-radius: 1px; background: currentColor; }
  .acc__icon::after { transform: rotate(90deg); }
  .acc__btn[aria-expanded="true"] .acc__icon { transform: rotate(135deg); background: var(--ink); color: #FFF; box-shadow: none; }
  .acc__panel p { max-width: 60ch; padding: 0 48px 24px 0; color: var(--ink-2); line-height: 1.6; }
  .acc__panel a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--teal); text-underline-offset: 3px; }
  .acc__panel.is-opening p { animation: fade-up .5s var(--ease); }
  .faq__more { position: relative; }
  .faq, .faq .acc__item, .faq__more { background: var(--mist); }
  .faq.sec--white, .faq.sec--white .acc__item, .faq.sec--white .faq__more { background: #FFF; }
</style>
