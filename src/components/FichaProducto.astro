---
// Plantilla de ficha de producto (única para ecógrafos, diatermias y el resto de equipos):
// migas, galería + datos clave y CTA, para quién es, características, especificaciones completas,
// qué incluye y normativa, garantía y servicio, relacionados y el bloque final con el formulario.
import '../styles/ficha.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Img from './Img.astro';
import ProductCard from './ProductCard.astro';
import Reasons from './Reasons.astro';
import CtaFinal from './CtaFinal.astro';
import { CAT } from '../data/categorias';
import type { Producto } from '../data/tipos';
import { altProducto, etiquetaModelo, relacionados, seoDescription, seoTitle, urlFicha } from '../data/productos';
import { EMPRESA, wa } from '../data/empresa';
import { imagen } from '../lib/imagenes';
import { h1Html } from '../lib/texto';
import { product } from '../lib/seo';
import { SITE_URL } from '../config';

interface Props { p: Producto }
const { p } = Astro.props;
const c = CAT[p.categoria];
const url = urlFicha(p)!;
const migas = c.pilar
  ? [{ name: 'Inicio', href: '/' }, { name: c.pilar && c.id === 'ecografia' ? 'Ecógrafos' : 'Diatermias', href: c.ruta }, { name: p.nombre, href: url }]
  : [{ name: 'Inicio', href: '/' }, { name: 'Equipos', href: '/equipos' }, { name: c.nombre, href: c.ruta }, { name: p.nombre, href: url }];
const alt = (i: number) => (i === 0 ? altProducto(p) : altProducto(p, p.imagenes[i].includes('consulta') ? 'en una consulta' : p.imagenes[i].includes('estuche') ? 'en su estuche de aluminio' : 'detalle de la pantalla'));
const zoom = await getImage({ src: imagen(p.imagenes[0]), format: 'webp', quality: 86 });
const ogImg = await getImage({ src: imagen(p.imagenes[0]), format: 'webp', width: 640 });
const specsLargas = p.especificaciones.length > 8;
const rel = relacionados(p);
const waTexto = `Hola, vengo de la web y me interesa el ${p.nombre} de ${p.marca}. ¿Me asesoráis?`;
const preset = { equipo: c.formEquipo, otro: c.formOtro, modelo: etiquetaModelo(p) };
// H1: el nombre del modelo con su última palabra como acento en cursiva (patrón de marca)
const corte = p.nombre.lastIndexOf(' ');
const tituloH1 = corte > 0 ? `${p.nombre.slice(0, corte)} *${p.nombre.slice(corte + 1)}*` : `*${p.nombre}*`;
---
<Base
  title={seoTitle(p)}
  description={seoDescription(p)}
  path={url}
  og={`/og/${p.slug}.jpg`}
  ogAlt={altProducto(p)}
  ogType="product"
  seccion={c.id === 'ecografia' ? 'ecografos' : c.id === 'diatermia' ? 'diatermias' : 'equipos'}
  migas={migas}
  jsonld={[product(p, [`${SITE_URL}${ogImg.src}`])]}
  viewContent={{ ids: [p.slug], type: 'product', category: c.nombre, name: `${p.nombre} (${p.marca})` }}
>
  <section class="fp" data-hero aria-labelledby="page-title">
    <div class="wrap">
      <Breadcrumbs migas={migas} />
      <div class="fp__grid">
        <div class="gal" data-gallery>
          <div class="gal__main">
            {p.imagenes.map((n, i) => (
              <div class:list={['gal__slide', { 'is-active': i === 0 }]} data-slide inert={i !== 0}>
                <Img name={n} alt={alt(i)} sizes="(min-width: 1200px) 600px, (min-width: 900px) 50vw, 92vw" widths={[320, 480, 640, 960]} priority={i === 0} vt={i === 0 ? `p-${p.slug}` : undefined} />
              </div>
            ))}
            <button class="gal__zoom" type="button" data-zoom-open aria-label="Ampliar la imagen"><svg class="icon" aria-hidden="true"><use href="#i-zoom"/></svg></button>
          </div>
          {p.imagenes.length > 1 && (
            <div class="gal__thumbs" role="group" aria-label="Imágenes del equipo">
              {p.imagenes.map((n, i) => (
                <button class="gal__thumb" type="button" data-thumb aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Ver imagen ${i + 1} de ${p.imagenes.length}`}><Img name={n} alt="" sizes="88px" widths={[96, 192]} /></button>
              ))}
            </div>
          )}
          <dialog class="gal__dialog" data-zoom aria-label={`Imagen ampliada: ${altProducto(p)}`}>
            <img src={zoom.src} width={zoom.attributes.width} height={zoom.attributes.height} alt={altProducto(p)} decoding="async" loading="lazy" />
            <span class="gal__close" aria-hidden="true"><svg class="icon"><use href="#i-close"/></svg></span>
          </dialog>
        </div>

        <div class="fp__info">
          <p class="fp__brand">{p.marca}<span aria-hidden="true"> · </span><a href={c.ruta}>{c.nombre}</a></p>
          <h1 class="h1 fp__title" id="page-title" set:html={h1Html(tituloH1)} />
          <p class="fp__ideal">Ideal para {p.idealPara}.</p>
          <dl class="fp__data">
            {p.datosClave.map((d) => <div><dt>{d.etiqueta}</dt><dd data-count>{d.valor}</dd></div>)}
          </dl>
          {p.modelos && (
            <ul class="fp__models">
              {p.modelos.map((m) => <li><strong>{m.nombre}</strong> {m.detalle}</li>)}
            </ul>
          )}
          <div class="fp__actions">
            <a class="btn btn--primary btn--lg" href="#asesoramiento" data-want={etiquetaModelo(p)} data-equipo={c.formEquipo} data-otro={c.formOtro} data-magnetic>Quiero asesoramiento</a>
            <a class="link fp__wa" href={wa(waTexto)} target="_blank" rel="noopener" data-origen="ficha"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>Pregúntanos por WhatsApp</a>
          </div>
          <p class="fp__price">Precio según configuración. Pídenos una propuesta sin compromiso.{p.nota && ` ${p.nota}`}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--white fp-sec" aria-labelledby="quien-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="quien-title" data-lines>Para quién <em>es.</em></h2>
        <p class="lead" data-rv>{p.descripcion}</p>
      </div>
      <ul class="uses">
        {p.paraQuien.map((u, i) => (
          <li class="uses__item" data-rv style={`--rd:${i * 80}ms`}>
            <span class="uses__ico" aria-hidden="true"><svg class="icon"><use href={`#i-uso-${u.icono}`}/></svg></span>
            <span class="uses__t">{u.texto}</span>
          </li>
        ))}
      </ul>
      <div class="sec__cta" data-rv>
        <a class="btn btn--primary" href="#asesoramiento" data-want={etiquetaModelo(p)} data-equipo={c.formEquipo} data-otro={c.formOtro}>Quiero asesoramiento</a>
      </div>
    </div>
  </section>

  <section class="sec fp-sec" aria-labelledby="car-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="car-title" data-lines>Lo que <em>importa.</em></h2>
      </div>
      <ul class="feat">
        {p.caracteristicas.map((f, i) => (
          <li class="feat__item" data-rv style={`--rd:${i * 70}ms`}>
            <span class="feat__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="feat__t">{f.titulo}</h3>
            {f.texto && <p class="feat__d">{f.texto}</p>}
          </li>
        ))}
      </ul>
      <div class="sec__cta" data-rv>
        <a class="btn btn--line" href="#especificaciones">Ver especificaciones</a>
      </div>
    </div>
  </section>

  <section class="sec sec--white fp-sec" id="especificaciones" aria-labelledby="spec-title">
    <div class="wrap fp-specs">
      <div class="fp-specs__main">
        <h2 class="h2" id="spec-title" data-lines>Especificaciones <em>completas.</em></h2>
        <div class="specs" data-specs>
          <table class="specs__table">
            <caption class="sr-only">Especificaciones técnicas del {p.nombre} de {p.marca}</caption>
            <tbody>
              {p.especificaciones.map((s, i) => (
                <tr class:list={{ 'is-extra': specsLargas && i >= 8 }}><th scope="row">{s.clave}</th><td>{s.valor}</td></tr>
              ))}
            </tbody>
          </table>
          {specsLargas && <button class="btn btn--line btn--sm specs__more" type="button" data-specs-btn aria-expanded="false" hidden>Ver todas<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></button>}
        </div>
        <p class="fp-src">Datos del {EMPRESA.catalogoNombre}{p.paginaCatalogo && `, página ${p.paginaCatalogo}`}. La propuesta final confirma especificaciones, accesorios y certificaciones para tu país. <a href={EMPRESA.catalogoPdf} download data-catalog data-origen="ficha">Descargar catálogo (PDF)</a></p>
      </div>
      <aside class="fp-specs__side" aria-label="Qué incluye, normativa y aplicaciones">
        {p.incluye.length > 0 && (
          <div class="side-box" data-rv>
            <h3 class="side-box__t">Qué incluye</h3>
            <ul class="side-box__list">{p.incluye.map((x) => <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>{x}</li>)}</ul>
          </div>
        )}
        {p.normativa && (
          <div class="side-box" data-rv>
            <h3 class="side-box__t">Normativa</h3>
            <p>{p.normativa}</p>
          </div>
        )}
        {p.usos.length > 0 && (
          <div class="side-box" data-rv>
            <h3 class="side-box__t">Aplicaciones según el fabricante</h3>
            <ul class="side-box__list side-box__list--dots">{p.usos.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}
      </aside>
    </div>
    <div class="wrap">
      <div class="sec__cta" data-rv>
        <a class="btn btn--primary" href="#asesoramiento" data-want={etiquetaModelo(p)} data-equipo={c.formEquipo} data-otro={c.formOtro}>Quiero asesoramiento</a>
      </div>
    </div>
  </section>

  <section class="sec sec--tight fp-sec" aria-labelledby="gar-title">
    <div class="wrap">
      <h2 class="fp-gar__title" id="gar-title">Garantía y servicio</h2>
      <Reasons fila />
    </div>
  </section>

  {rel.length > 0 && (
    <section class="sec sec--white" aria-labelledby="rel-title">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="rel-title" data-lines>También te puede <em>interesar.</em></h2>
        </div>
        <ul class="grid grid--3 rel">
          {rel.map((r) => <li><ProductCard p={r} vt /></li>)}
        </ul>
        <div class="sec__cta" data-rv>
          <a class="btn btn--dark" href={c.ruta}>Ver {c.pilar ? `todos los ${c.id === 'ecografia' ? 'ecógrafos' : 'equipos de diatermia'}` : `toda la categoría ${c.corto.toLowerCase()}`}<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </section>
  )}

  <CtaFinal preset={preset} subtitulo={`Te asesoran fisioterapeutas sobre el ${p.nombre} y su configuración. Sin compromiso y sin letra pequeña.`} />
</Base>
