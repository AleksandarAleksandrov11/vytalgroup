---
// Plantilla de ficha de producto (única para ecógrafos, diatermias y el resto de equipos):
// migas, galería + datos clave y CTA, para quién es, características, especificaciones completas,
// qué incluye y normativa, garantía y servicio, relacionados y el bloque final con el formulario.
import '../styles/ficha.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Img from './Img.astro';
import ProductCard from './ProductCard.astro';
import Reasons from './Reasons.astro';
import CtaFinal from './CtaFinal.astro';
import Faq from './Faq.astro';
import { CAT } from '../data/categorias';
import type { Producto } from '../data/tipos';
import { altProducto, etiquetaModelo, relacionados, seoDescription, seoTitle, urlFicha } from '../data/productos';
import { EMPRESA, wa } from '../data/empresa';
import { imagen, escena } from '../lib/imagenes';
import { h1Html, unidades } from '../lib/texto';
import { product, faqPage } from '../lib/seo';
import { faqsFicha, sujeto, deSujeto } from '../data/faqs';
import { SITE_URL } from '../config';

interface Props { p: Producto }
const { p } = Astro.props;
const c = CAT[p.categoria];
const url = urlFicha(p)!;
const migas = c.pilar
  ? [{ name: 'Inicio', href: '/' }, { name: c.pilar && c.id === 'ecografia' ? 'Ecógrafos' : 'Diatermias', href: c.ruta }, { name: p.nombre, href: url }]
  : [{ name: 'Inicio', href: '/' }, { name: 'Equipos', href: '/equipos' }, { name: c.nombre, href: c.ruta }, { name: p.nombre, href: url }];
const alt = (i: number) => (i === 0 ? altProducto(p) : altProducto(p, p.imagenes[i].includes('consulta') ? 'en una consulta' : p.imagenes[i].includes('estuche') ? 'en su estuche de aluminio' : 'detalle de la pantalla'));
const zoom = await getImage({ src: imagen(p.imagenes[0]), format: 'webp', quality: 86 });
// JSON-LD: todas las fotos del equipo, a 1280 px
const ldImgs = await Promise.all(p.imagenes.map((n) => getImage({ src: imagen(n), format: 'webp', width: Math.min(1280, imagen(n).width) })));
const specsLargas = p.especificaciones.length > 8;
const rel = relacionados(p);
const waTexto = `Hola, vengo de la web y me interesa ${sujeto(p)} de ${p.marca}. ¿Me asesoráis?`;
const preset = { equipo: c.formEquipo, otro: c.formOtro, modelo: etiquetaModelo(p) };
// H1: qué es y el modelo, con el modelo como acento en cursiva ("Ecógrafo *Acclarix AX8*"). Si el nombre
// ya dice qué es ("Camilla Eléctrica Estándar", "Láser terapéutico"), su última palabra es el acento.
const faqs = faqsFicha(p);
const esFoto = (n: string) => n.startsWith('fotos/');
const PREFIJO: Record<string, string> = { ecografia: 'Ecógrafo', diatermia: 'Diatermia', 'ondas-de-choque': 'Ondas de choque', magnetoterapia: 'Magnetoterapia', laser: 'Láser', 'electrolisis-percutanea': 'Electrólisis', electroterapia: 'Electroterapia', ultrasonidos: 'Ultrasonidos', presoterapia: 'Presoterapia', 'diatermia-microondas': 'Diatermia por microondas' };
const pre = p.prefijoH1 ?? PREFIJO[p.categoria] ?? (p.tipo.length <= 28 ? p.tipo.charAt(0).toUpperCase() + p.tipo.slice(1) : '');
const yaLoDice = !pre || p.nombre.toLowerCase().startsWith(pre.split(' ')[0].toLowerCase());
const corte = p.nombre.lastIndexOf(' ');
const tituloH1 = !yaLoDice ? `${pre} *${p.nombre}*` : corte > 0 ? `${p.nombre.slice(0, corte)} *${p.nombre.slice(corte + 1)}*` : `*${p.nombre}*`;
---
<Base
  title={seoTitle(p)}
  description={seoDescription(p)}
  path={url}
  og={`/og/${p.slug}.jpg`}
  ogAlt={altProducto(p)}
  ogType="product"
  seccion={c.id === 'ecografia' ? 'ecografos' : c.id === 'diatermia' ? 'diatermias' : 'equipos'}
  migas={migas}
  jsonld={[product(p, ldImgs.map((i) => `${SITE_URL}${i.src}`)), faqPage(faqs)]}
  waTexto={`Hola, vengo de la web de VytalGroup y me interesa el equipo ${p.nombre} de ${p.marca}. ¿Me podéis asesorar?`}
>
  <section class="phero fp on-dark" data-hero aria-labelledby="page-title">
    <div class="wrap">
      <Breadcrumbs migas={migas} oscuro />
      <div class="phero__grid fp__grid">
        <div class="phero__copy fp__info">
          <h1 class="h1 fp__title" id="page-title" set:html={h1Html(tituloH1)} />
          <p class="fp__brand">{p.marca}<span aria-hidden="true"> · </span><a href={c.ruta}>{c.nombre}</a></p>
          <p class="fp__ideal">Ideal para {p.idealPara}.</p>
          <dl class:list={['fp__data', `fp__data--${p.datosClave.length}`]}>
            {p.datosClave.map((d) => <div><dt>{d.etiqueta}</dt><dd>{unidades(d.valor)}</dd></div>)}
          </dl>
          {p.modelos && (
            <ul class="fp__models">
              {p.modelos.map((m) => <li><strong>{m.nombre}</strong> {m.detalle}</li>)}
            </ul>
          )}
          <div class="fp__actions">
            <a class="btn btn--primary btn--lg" href="#asesoramiento" data-want={etiquetaModelo(p)} data-equipo={c.formEquipo} data-otro={c.formOtro} data-magnetic>Quiero asesoramiento</a>
            <a class="link fp__wa" href={wa(waTexto)} target="_blank" rel="noopener" data-origen="ficha"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>Pregúntanos por WhatsApp</a>
          </div>
          <p class="fp__price">Precio según configuración. Pídenos una propuesta sin compromiso.{p.nota && ` ${p.nota}`}</p>
        </div>
        <div class="phero__visual gal" data-gallery>
          <div class="gal__main">
            {p.imagenes.map((n, i) => (
              <div class:list={['gal__slide', { 'is-active': i === 0, 'gal__slide--foto': esFoto(n), stage: !esFoto(n) }]} style={escena(n)} data-slide inert={i !== 0}>
                <Img name={n} alt={alt(i)} sizes="(min-width: 1200px) 600px, (min-width: 900px) 50vw, 92vw" widths={[320, 480, 640, 720, 960, 1280]} priority={i === 0} vt={i === 0 ? `p-${p.slug}` : undefined} />
              </div>
            ))}
            <button class="gal__zoom" type="button" data-zoom-open aria-label="Ampliar la imagen"><svg class="icon" aria-hidden="true"><use href="#i-zoom"/></svg></button>
          </div>
          {p.imagenes.length > 1 && (
            <div class="gal__thumbs" role="group" aria-label="Imágenes del equipo">
              {p.imagenes.map((n, i) => (
                <button class="gal__thumb" type="button" data-thumb aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Ver imagen ${i + 1} de ${p.imagenes.length}`}><Img name={n} alt={alt(i)} sizes="88px" widths={[96, 192, 264]} /></button>
              ))}
            </div>
          )}
          <dialog class="gal__dialog" data-zoom aria-label={`Imagen ampliada: ${altProducto(p)}`}>
            <img src={zoom.src} width={zoom.attributes.width} height={zoom.attributes.height} alt={altProducto(p)} decoding="async" loading="lazy" />
            <span class="gal__close" aria-hidden="true"><svg class="icon"><use href="#i-close"/></svg></span>
          </dialog>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--white fp-sec" aria-labelledby="car-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="car-title" data-lines>Lo que <em>importa.</em></h2>
        <p class="lead" data-rv>{p.descripcion}</p>
      </div>
      <ul class="feat">
        {p.caracteristicas.map((f, i) => (
          <li class="feat__item" data-rv data-tilt style={`--rd:${i * 70}ms`}>
            <span class="feat__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="feat__t">{f.titulo}</h3>
            {f.texto && <p class="feat__d">{f.texto}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sec--mist fp-sec" id="especificaciones" aria-labelledby="spec-title">
    <div class="wrap fp-specs">
      <div class="fp-specs__main">
        <h2 class="h2" id="spec-title" data-lines>Especificaciones <em>completas.</em></h2>
        <div class="specs" data-specs>
          <table class="specs__table">
            <caption class="sr-only">Especificaciones técnicas {deSujeto(p)} de {p.marca}</caption>
            <tbody>
              {p.especificaciones.map((s, i) => (
                <tr class:list={{ 'is-extra': specsLargas && i >= 8 }}><th scope="row">{s.clave}</th><td>{unidades(s.valor)}</td></tr>
              ))}
            </tbody>
          </table>
          {specsLargas && <button class="btn btn--line btn--sm specs__more" type="button" data-specs-btn aria-expanded="false" hidden>Ver todas<svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg></button>}
        </div>
        <p class="fp-src">Datos {p.fuente ? `de ${p.fuente}` : `del ${EMPRESA.catalogoNombre}`}{p.paginaCatalogo && `, página ${p.paginaCatalogo}`}. La propuesta final confirma especificaciones, accesorios y certificaciones para tu país. <a href={EMPRESA.catalogoPdf} download data-catalog data-origen="ficha">Descargar catálogo (PDF)</a></p>
      </div>
      <aside class="fp-specs__side" aria-label="Aplicaciones, qué incluye y normativa">
        {p.usos.length > 0 && (
          <div class="side-box" data-rv>
            <h3 class="side-box__t">Aplicaciones según el fabricante</h3>
            <ul class="side-box__list side-box__list--dots">{p.usos.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}
        {p.incluye.length > 0 && (
          <div class="side-box" data-rv>
            <h3 class="side-box__t">Qué incluye</h3>
            <ul class="side-box__list">{p.incluye.map((x) => <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>{x}</li>)}</ul>
          </div>
        )}
        <div class="side-box" data-rv>
          <h3 class="side-box__t">Normativa</h3>
          <p>{p.normativa || 'Te confirmamos la certificación y la documentación aplicable a tu país con la propuesta.'}</p>
        </div>
      </aside>
    </div>
    <div class="wrap">
    </div>
  </section>

  <section class="sec sec--dark on-dark fp-sec" aria-labelledby="gar-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="gar-title" data-lines>Tu equipo, con <em>garantía y servicio.</em></h2>
      </div>
      <Reasons fila />
    </div>
  </section>

  <Faq faqs={faqs} titulo={`Dudas sobre *${p.nombre}.*`} id="preguntas" cta={false} />

  {rel.length > 0 && (
    <section class="sec sec--teal" aria-labelledby="rel-title">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="rel-title" data-lines>También te puede <em>interesar.</em></h2>
        </div>
        <ul class="grid grid--3 rel">
          {rel.map((r) => <li><ProductCard p={r} vt /></li>)}
        </ul>
        <div class="sec__cta" data-rv>
          <a class="btn btn--dark" href={c.ruta}>Ver {c.pilar ? `todos los ${c.id === 'ecografia' ? 'ecógrafos' : 'equipos de diatermia'}` : `toda la categoría ${c.corto.toLowerCase()}`}<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </section>
  )}

  <CtaFinal preset={preset} subtitulo={`Te asesoran fisioterapeutas sobre ${sujeto(p)} y su configuración. Sin compromiso.`} />
</Base>
