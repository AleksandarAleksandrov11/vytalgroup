---
// Tarjeta mínima de guía: imagen, título, resumen y minutos de lectura.
import Img from './Img.astro';
import { minutosLectura } from '../lib/texto';
import type { CollectionEntry } from 'astro:content';

interface Props { g: CollectionEntry<'guias'>; nivel?: 'h2' | 'h3' }
const { g, nivel = 'h3' } = Astro.props;
const H = nivel;
---
<article class="gc" data-halo data-tilt>
  <div class="gc__media" data-rvi><Img name={g.data.imagen} alt={g.data.imagenAlt} sizes="(min-width: 900px) 370px, (min-width: 640px) 46vw, 88vw" /></div>
  <div class="gc__body">
    <p class="gc__meta">Guía · {minutosLectura(g.body || '')} min de lectura</p>
    <H class="gc__title"><a href={`/guias/${g.id}`}>{g.data.corto}</a></H>
    <p class="gc__txt">{g.data.resumen}</p>
  </div>
</article>
<style is:global>
  .gc { position: relative; display: flex; flex-direction: column; height: 100%; padding: 10px; border-radius: var(--r-lg); background: #FFF; box-shadow: inset 0 0 0 1px var(--line), var(--shadow); transition: transform .5s var(--ease), box-shadow .35s ease; }
  .gc__media { border-radius: var(--r-sm); overflow: hidden; aspect-ratio: 4 / 3; background: #FFF; }
  .gc__media img { width: 100%; height: 100%; object-fit: cover; transition: scale .7s var(--ease); }
  .gc__body { display: grid; gap: 6px; padding: 14px 10px 10px; }
  .gc__meta { font-size: .8125rem; color: var(--ink-3); }
  .gc__title { font-size: 1.1875rem; font-weight: 560; line-height: 1.3; letter-spacing: -.02em; text-wrap: balance; }
  .gc__title a { color: inherit; text-decoration: none; }
  .gc__title a::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: var(--r-lg); }
  .gc__txt { font-size: .9375rem; line-height: 1.5; color: var(--ink-2); }
  @media (hover: hover) and (pointer: fine) {
    .gc:hover { box-shadow: inset 0 0 0 1px var(--line), var(--shadow-hover); }
    .gc:hover .gc__media img { scale: 1.04; }
    .gc:hover .gc__title a { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  }
  .gc__title a:focus-visible { outline: none; }
  .gc:has(.gc__title a:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }
</style>
