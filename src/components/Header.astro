---
// Cabecera con fondo sólido: logo, navegación (Ecógrafos · Diatermias · Equipos · Catálogo · Guías ·
// Sobre nosotros · Contacto) y "Quiero asesoramiento". Animaciones circulares: el punto que viaja bajo
// el enlace activo o señalado, el relleno que crece en círculo desde el cursor y el desplegable de
// Equipos, que se abre en círculo. En móvil la cabecera queda fija; la hamburguesa de 3 líneas abre un
// panel de color que se revela en círculo desde el botón, con desplegables propios y enlaces escalonados.
import '../styles/header.css';
import Thumb from './Thumb.astro';
import { CATEGORIAS } from '../data/categorias';
import { PRODUCTOS, deCategoria, urlFicha, altProducto } from '../data/productos';
import { EMPRESA, wa } from '../data/empresa';
import type { Seccion } from '../layouts/Base.astro';

interface Props { seccion: Seccion; conFormulario: boolean; path: string }
const { seccion, conFormulario, path } = Astro.props;
const cta = conFormulario ? '#asesoramiento' : '/contacto#asesoramiento';
const nav = [
  { id: 'ecografos', label: 'Ecógrafos', href: '/ecografos' },
  { id: 'diatermias', label: 'Diatermias', href: '/diatermias' },
  { id: 'equipos', label: 'Equipos', href: '/equipos', menu: true },
  { id: 'catalogo', label: 'Catálogo', href: '/catalogo' },
  { id: 'guias', label: 'Guías', href: '/guias' },
  { id: 'sobre-nosotros', label: 'Sobre nosotros', href: '/sobre-nosotros' },
  { id: 'contacto', label: 'Contacto', href: '/contacto' },
];
const actual = (href: string) => (path === href ? 'page' : undefined);
const cuenta = (n: number) => `${n} ${n === 1 ? 'equipo' : 'equipos'}`;

// Desplegables del menú móvil
const eco = PRODUCTOS.filter((p) => p.categoria === 'ecografia');
const formatos = [
  { id: 'inalambrico', label: 'De bolsillo e inalámbricos', img: 'ecografo-inalambrico-eco-wireless-vytamed', alt: 'Ecógrafo inalámbrico Eco Wireless de VytaMeD' },
  { id: 'portatil', label: 'Portátiles', img: 'ecografo-portatil-acclarix-ax8-edan', alt: 'Ecógrafo portátil Acclarix AX8 de EDAN' },
  { id: 'carro', label: 'De carro', img: 'ecografo-de-carro-acclarix-lx9-edan', alt: 'Ecógrafo de carro Acclarix LX9 de EDAN' },
].map((f) => ({ ...f, n: eco.filter((p) => p.formato === f.id).length }));
const diatermias = deCategoria('diatermia').filter((p) => p.categoria === 'diatermia');
---
<header class="hd" data-header>
  <div class="hd__bar wrap">
    <a class="hd__logo" href="/" aria-label="VytalGroup, ir al inicio" aria-current={path === '/' ? 'page' : undefined}><svg class="logo" viewBox="0 0 1117 171" aria-hidden="true"><use href="#logo"/></svg></a>

    <nav class="hd__nav" aria-label="Principal">
      <ul class="hd__list" data-nav>
        {nav.map((item) => (
          <li class:list={['hd__item', { 'is-active': seccion === item.id }]}>
            {item.menu ? (
              <>
                <button class="hd__link hd__trigger" type="button" aria-expanded="false" aria-controls="menu-equipos" data-dropdown-btn data-fill>
                  <span>{item.label}</span><svg class="icon" aria-hidden="true"><use href="#i-chevron"/></svg>
                </button>
                <div class="dd" id="menu-equipos" data-dropdown hidden>
                  <div class="dd__in">
                    <ul class="dd__grid">
                      {CATEGORIAS.map((c, i) => (
                        <li style={`--i:${i}`}>
                          <a class="dd__cat" href={c.ruta} aria-current={actual(c.ruta)}>
                            <span class="dd__thumb"><Thumb name={c.imagen} alt={`Equipo de ${c.corto.toLowerCase()}`} size={56} /></span>
                            <span class="dd__txt"><span class="dd__name">{c.nombre}</span> <span class="dd__count">{cuenta(deCategoria(c.id).length)}</span></span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <div class="dd__foot">
                      <a class="link" href="/equipos">Ver todas las categorías<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
                      <a class="link" href="/catalogo">Catálogo completo<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a class="hd__link" href={item.href} aria-current={actual(item.href)} data-fill><span>{item.label}</span></a>
            )}
          </li>
        ))}
      </ul>
      <span class="hd__dot" aria-hidden="true" data-nav-dot></span>
    </nav>

    <div class="hd__end">
      <a class="btn btn--primary btn--sm hd__cta" href={cta} data-cta data-fill><span>Quiero asesoramiento</span></a>
      <button class="hd__menu" type="button" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir el menú" data-menu-btn>
        <span class="hd__burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mm" id="menu-movil" role="dialog" aria-modal="true" aria-label="Menú" data-menu hidden>
  <div class="mm__glow" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="mm__in wrap">
    <nav aria-label="Menú móvil">
      <ul class="mm__list">
        <li class="mm__li" style="--i:0">
          <button class="mm__link mm__acc" type="button" aria-expanded="false" aria-controls="mm-eco" data-mm-acc>
            <span class="mm__n" aria-hidden="true"></span><span class="mm__t">Ecógrafos</span><span class="mm__chev" aria-hidden="true"></span>
          </button>
          <div class="mm__sub" id="mm-eco" data-mm-sub inert>
            <div class="mm__sub-in">
              <ul class="mm__rows">
                {formatos.map((f, i) => (
                  <li style={`--j:${i}`}><a class="mm__row" href={`/ecografos#gama-${f.id}`}><span class="mm__thumb"><Thumb name={f.img} alt={f.alt} size={48} /></span><span class="mm__row-t">{f.label}</span> <span class="mm__row-n">{f.n}</span></a></li>
                ))}
              </ul>
              <a class="mm__all" href="/ecografos" aria-current={actual('/ecografos')}>Ver todos los ecógrafos<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </div>
          </div>
        </li>
        <li class="mm__li" style="--i:1">
          <button class="mm__link mm__acc" type="button" aria-expanded="false" aria-controls="mm-dia" data-mm-acc>
            <span class="mm__n" aria-hidden="true"></span><span class="mm__t">Diatermias</span><span class="mm__chev" aria-hidden="true"></span>
          </button>
          <div class="mm__sub" id="mm-dia" data-mm-sub inert>
            <div class="mm__sub-in">
              <ul class="mm__rows">
                {diatermias.map((p, i) => (
                  <li style={`--j:${i}`}><a class="mm__row" href={urlFicha(p)} aria-current={actual(urlFicha(p)!)}><span class="mm__thumb"><Thumb name={p.imagenes[0]} alt={altProducto(p)} size={48} /></span><span class="mm__row-t">{p.nombre} <small>{p.marca}</small></span></a></li>
                ))}
              </ul>
              <a class="mm__all" href="/diatermias" aria-current={actual('/diatermias')}>Ver todas las diatermias<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </div>
          </div>
        </li>
        <li class="mm__li" style="--i:2">
          <button class="mm__link mm__acc" type="button" aria-expanded="false" aria-controls="mm-equipos" data-mm-acc>
            <span class="mm__n" aria-hidden="true"></span><span class="mm__t">Equipos</span><span class="mm__chev" aria-hidden="true"></span>
          </button>
          <div class="mm__sub" id="mm-equipos" data-mm-sub inert>
            <div class="mm__sub-in">
              <ul class="mm__rows mm__rows--2">
                {CATEGORIAS.filter((c) => !c.pilar).map((c, i) => (
                  <li style={`--j:${i}`}><a class="mm__row" href={c.ruta} aria-current={actual(c.ruta)}><span class="mm__thumb"><Thumb name={c.imagen} alt={`Equipo de ${c.corto.toLowerCase()}`} size={48} /></span><span class="mm__row-t">{c.nombre} <small>{cuenta(deCategoria(c.id).length)}</small></span></a></li>
                ))}
              </ul>
              <a class="mm__all" href="/equipos" aria-current={actual('/equipos')}>Ver todas las categorías<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </div>
          </div>
        </li>
        {[
          { label: 'Catálogo', href: '/catalogo' },
          { label: 'Guías', href: '/guias' },
          { label: 'Sobre nosotros', href: '/sobre-nosotros' },
          { label: 'Contacto', href: '/contacto' },
        ].map((l, i) => (
          <li class="mm__li" style={`--i:${i + 3}`}><a class="mm__link" href={l.href} aria-current={actual(l.href)}><span class="mm__n" aria-hidden="true"></span><span class="mm__t">{l.label}</span><svg class="icon mm__arrow" aria-hidden="true"><use href="#i-arrow"/></svg></a></li>
        ))}
      </ul>
    </nav>
    <div class="mm__foot" style="--i:7">
      <a class="btn btn--primary btn--lg btn--block" href={cta} data-cta data-menu-close>Quiero asesoramiento</a>
      <ul class="mm__contact">
        <li><a href={wa()} target="_blank" rel="noopener" data-contact="whatsapp" data-origen="menu"><span class="mm__ico"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg></span>WhatsApp</a></li>
        <li><a href={EMPRESA.telefonoHref} data-contact="telefono" data-origen="menu"><span class="mm__ico"><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg></span>Llamar</a></li>
        <li><a href={`mailto:${EMPRESA.email}`} data-contact="email" data-origen="menu"><span class="mm__ico"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg></span>Email</a></li>
      </ul>
    </div>
  </div>
</div>
