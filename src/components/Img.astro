---
// Imagen de contenido: <picture> en WebP con srcset, sizes y dimensiones fijas (CLS 0). El codificador WebP está
// ajustado en astro.config.ts. Carga diferida salvo que sea el LCP (priority → fetchpriority="high" e inmediata).
import { Picture } from 'astro:assets';
import { imagen, anchos } from '../lib/imagenes';

interface Props {
  name: string;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  vt?: string;
  parallax?: boolean;
  /** Calidad WebP (por defecto la de cada códec). Las fotos de fondo de sección (desenfocadas) van a 60. */
  quality?: number;
}
const { name, alt, sizes, widths = [240, 320, 480, 640], priority = false, class: cls, pictureClass, vt, parallax = false, quality } = Astro.props;
const meta = imagen(name);
const w = anchos(meta, widths);
---
<Picture
  src={meta}
  alt={alt}
  formats={['webp']}
  fallbackFormat="webp"
  widths={w}
  sizes={sizes}
  width={meta.width}
  height={meta.height}
  loading={priority ? 'eager' : 'lazy'}
  decoding="async"
  quality={quality}
  fetchpriority={priority ? 'high' : undefined}
  class={cls}
  style={vt ? `view-transition-name: ${vt}` : undefined}
  data-parallax={parallax ? '' : undefined}
  pictureAttributes={{ class: pictureClass }}
/>
