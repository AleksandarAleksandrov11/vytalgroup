---
// Formulario de 4 pasos, idéntico al de la landing (mismos textos, diseño y animaciones).
// Con `preset`, la pregunta 1 llega respondida: "Te interesa: [modelo] · Cambiar".
import '../styles/form.css';
import { OTROS_EQUIPOS } from '../data/categorias';
import { EMPRESA, wa } from '../data/empresa';

export interface Preset { equipo: string; otro?: string; modelo?: string }
interface Props { preset?: Preset; tituloId?: string }
const { preset, tituloId = 'form-title' } = Astro.props;
const con = !!preset?.equipo;
const corto = (m: string) => m.replace(/\s*\([^)]*\)$/, '');
const interesa = preset?.modelo ? corto(preset.modelo) : preset?.equipo === 'Otro equipo' ? preset?.otro || 'Otro equipo' : preset?.equipo;
const EQUIPOS = ['Ecógrafo', 'Diatermia', 'Presoterapia', 'Ondas de choque', 'Otro equipo'];
const PERFILES = ['Clínica', 'Fisioterapeuta', 'Médico', 'Otro'];
---
<form class="qf" id="qf" novalidate aria-labelledby={tituloId}
  data-otros={JSON.stringify(OTROS_EQUIPOS)}
  data-preset-equipo={preset?.equipo}
  data-preset-otro={preset?.otro}
  data-preset-modelo={preset?.modelo}>
  <div class="qf__bar" role="progressbar" aria-label="Progreso del formulario" aria-valuemin="1" aria-valuemax="4" aria-valuenow={con ? 2 : 1} aria-valuetext={`Paso ${con ? 2 : 1} de 4`}><span data-progress style={`--p:${con ? 0.5 : 0.25}`}></span></div>
  <div class="qf__nav"><button class="qf__back" type="button" data-back aria-label="Volver a la pregunta anterior" hidden={!con}><svg class="icon icon--flip" aria-hidden="true"><use href="#i-arrow"/></svg></button><span class="qf__count" aria-hidden="true" data-count-step>{con ? '2/4' : '1/4'}</span></div>

  <fieldset class:list={['qf__step', { 'is-active': !con }]} data-step="1">
    <legend class="qf__q">¿Qué equipo te interesa?</legend>
    <div class="opts" data-opts>
      {EQUIPOS.map((v) => <label class="opt"><input type="radio" name="equipo" value={v} checked={preset?.equipo === v}><span>{v}</span></label>)}
    </div>
    <div class="qf__other" data-other hidden={preset?.equipo !== 'Otro equipo'}>
      <p class="qf__other-label" id="q-other">¿Cuál?</p>
      <div data-other-select></div>
    </div>
    <p class="qf__err" data-error></p>
    <button class:list={['btn btn--primary btn--block qf__next', { 'is-shown': con }]} type="button" data-next>Siguiente</button>
  </fieldset>

  <fieldset class:list={['qf__step', { 'is-active': con }]} data-step="2">
    <legend class="qf__q">¿Cuál es tu perfil?</legend>
    <div class="qf__picked" data-picked-box hidden={!con}>
      <p>Te interesa: <strong data-picked>{interesa}</strong></p>
      <button class="link" type="button" data-change>Cambiar</button>
    </div>
    <div class="opts" data-opts>
      {PERFILES.map((v) => <label class="opt"><input type="radio" name="perfil" value={v}><span>{v}</span></label>)}
    </div>
    <p class="qf__err" data-error></p>
    <button class="btn btn--primary btn--block qf__next" type="button" data-next>Siguiente</button>
  </fieldset>

  <div class="qf__step" data-step="3" role="group" aria-labelledby="q-name">
    <label class="qf__q" id="q-name" for="f-name">¿Cómo te llamas?</label>
    <input class="field" id="f-name" name="nombre" type="text" autocomplete="name" autocapitalize="words" enterkeyhint="next" maxlength="80" placeholder="Tu nombre" aria-describedby="e-name">
    <p class="qf__err" id="e-name" data-error-name></p>
    <button class="btn btn--primary btn--block qf__next is-shown" type="button" data-next>Siguiente</button>
  </div>

  <div class="qf__step" data-step="4" role="group" aria-labelledby="q-tel">
    <div class="qf__contact" data-contact="tel">
      <label class="qf__q" id="q-tel" for="f-tel">¿A qué WhatsApp te escribimos?</label>
      <div class="tel">
        <div class="tel__prefix" data-prefix></div>
        <input class="field" id="f-tel" name="telefono" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="send" maxlength="22" placeholder="612 345 678" aria-describedby="e-tel">
      </div>
      <p class="qf__err" id="e-tel" data-error-tel></p>
      <button class="link qf__switch" type="button" data-switch="email">Prefiero por correo</button>
    </div>
    <div class="qf__contact" data-contact="email" hidden>
      <label class="qf__q" id="q-email" for="f-email">¿A qué correo te escribimos?</label>
      <input class="field" id="f-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" maxlength="254" placeholder="nombre@correo.com" aria-describedby="e-email">
      <p class="qf__err" id="e-email" data-error-email></p>
      <p class="qf__hint" data-email-hint hidden>¿Querías decir <button class="link" type="button" data-email-fix></button>?</p>
      <button class="link qf__switch" type="button" data-switch="tel">Prefiero por WhatsApp</button>
    </div>
    <label class="check">
      <input type="checkbox" name="consent" aria-describedby="e-consent">
      <span class="check__box" aria-hidden="true"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg></span>
      <span class="check__txt">Acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> y que VytalGroup me contacte.</span>
    </label>
    <p class="qf__err" id="e-consent" data-error-consent></p>
    <button class="btn btn--primary btn--block qf__send" type="submit" data-submit><span>Enviar</span></button>
  </div>

  <div class="hp" aria-hidden="true"><label>Web <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

  <div class="qf__end" data-done tabindex="-1" hidden>
    <p class="qf__end-title" data-done-title>Gracias. Te escribimos muy pronto.</p>
    <p class="sign sign--dark"><svg class="sign__svg" viewBox="0 0 3592 1230" role="img" aria-label="Firma de Javier"><use href="#sig"/></svg><span>Javier Ruiz, fisioterapeuta</span></p>
    <a class="btn btn--primary btn--block" href={wa()} target="_blank" rel="noopener" data-done-wa data-origen="gracias"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp"/></svg>Escríbenos ya por WhatsApp</a>
    <a class="link" href="/catalogo">Ver el catálogo completo</a>
  </div>

  <div class="qf__end" data-fail tabindex="-1" hidden>
    <p class="qf__end-title">No se ha podido enviar.</p>
    <p class="qf__end-text">Tus datos siguen aquí. Vuelve a intentarlo o escríbenos por WhatsApp.</p>
    <button class="btn btn--primary btn--block" type="button" data-retry>Reintentar</button>
    <a class="link" href={wa()} target="_blank" rel="noopener" data-fail-wa data-origen="error">Escribir por WhatsApp</a>
  </div>

  <p class="sr-only" aria-live="polite" data-live></p>
</form>
