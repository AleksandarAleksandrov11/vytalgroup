---
// Cinta de confianza (las "stats") en movimiento continuo (como la de la landing): se pausa al pasar el ratón y
// fuera de pantalla. Con movimiento reducido, queda quieta y centrada.
import { CINTA } from '../data/empresa';
---
<section class="stats" aria-label="Lo que te garantizamos">
  <div class="ticker" data-marquee data-enter style="--ed:.8s">
    <div class="ticker__track">
      {[0, 1, 2, 3].map((k) => (
        <ul class="ticker__list" aria-hidden={k > 0 ? 'true' : undefined}>
          {CINTA.map((c) => (
            <li><span class="ticker__ico"><svg class="icon" aria-hidden="true"><use href={`#${c.icono}`}/></svg></span><span><span class="ticker__k">{c.fuerte}</span> {c.resto}</span></li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
<style is:global>
  :root { --band: 78px; }
  @media (min-width: 900px) { :root { --band: 88px; } }
  .stats { position: relative; background: #FFF; box-shadow: 0 1px 0 var(--line), 0 -1px 0 var(--line); }
  .ticker { position: relative; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .ticker__track { display: flex; width: max-content; animation: marquee 52s linear infinite; }
  .ticker:hover .ticker__track, [data-marquee].is-paused .ticker__track { animation-play-state: paused; }
  .ticker__list { display: flex; flex: none; }
  .ticker__list li { position: relative; display: flex; align-items: center; gap: 12px; min-height: var(--band); padding: 12px 30px; font-size: .9375rem; line-height: 1.25; color: var(--ink-2); white-space: nowrap; }
  .ticker__list li .ticker__k { font-size: 1.0625rem; font-weight: 560; letter-spacing: -.015em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ticker__ico { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--teal-soft); color: var(--teal-ink); }
  .ticker__ico .icon { width: 21px; height: 21px; }
  .ticker__list li::after { content: ""; position: absolute; right: -2.5px; top: 50%; width: 5px; height: 5px; margin-top: -2.5px; border-radius: 50%; background: rgba(72, 160, 168, .45); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (min-width: 900px) {
    .ticker__list li { gap: 14px; padding: 14px 40px; font-size: 1rem; }
    .ticker__list li .ticker__k { font-size: 1.125rem; }
    .ticker__ico { width: 44px; height: 44px; }
    .ticker__ico .icon { width: 22px; height: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; width: auto; }
    .ticker__list[aria-hidden="true"] { display: none; }
    .ticker__list { flex: 1; flex-wrap: wrap; justify-content: center; padding: 8px 0; }
    .ticker__list li { min-height: 0; padding: 8px 20px; }
    .ticker__list li::after { display: none; }
    .ticker { -webkit-mask-image: none; mask-image: none; }
  }
</style>
