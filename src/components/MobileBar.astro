---
// Barra CTA fija en móvil: "Quiero asesoramiento" (el WhatsApp es el botón flotante, que se coloca encima).
// Aparece al pasar el hero, se oculta con el formulario en pantalla y respeta el safe-area de iOS.
interface Props { conFormulario: boolean }
const { conFormulario } = Astro.props;
---
<div class="mbar" data-mbar inert>
  <a class="btn btn--primary mbar__cta" href={conFormulario ? '#asesoramiento' : '/contacto#asesoramiento'} data-cta>Quiero asesoramiento</a>
</div>
<style is:global>
  .mbar { position: fixed; z-index: 45; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; padding: 10px max(12px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left)); background: rgba(250, 251, 252, .86); -webkit-backdrop-filter: saturate(1.8) blur(16px); backdrop-filter: saturate(1.8) blur(16px); box-shadow: 0 -1px 0 var(--line); transform: translateY(110%); transition: transform .5s var(--ease); }
  .mbar.is-on { transform: none; }
  html.has-cookie-banner .mbar, html.menu-open .mbar { transform: translateY(110%); }
  .mbar__cta { flex: 1 1 auto; min-width: 0; min-height: 52px; padding: 0 16px; }
  @media (min-width: 900px) { .mbar { display: none; } }
</style>
