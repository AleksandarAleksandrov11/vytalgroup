---
// Tarjeta de producto: imagen 4:3, nombre, una línea, 2 datos clave y "Ver ficha".
// Si el equipo no tiene ficha, el botón abre el formulario con el producto preseleccionado.
// Con `vt`, la imagen "vuela" a la ficha (view-transition-name único por producto).
import '../styles/cards.css';
import Img from './Img.astro';
import type { Producto } from '../data/tipos';
import { CAT } from '../data/categorias';
import { urlFicha, altProducto, etiquetaModelo } from '../data/productos';

interface Props {
  p: Producto;
  nivel?: 'h2' | 'h3';
  vt?: boolean;
  datos?: boolean;
  marca?: boolean;
  categoria?: boolean;
  linea?: 'resumen' | 'ideal';
  sizes?: string;
  priority?: boolean;
  traits?: boolean;
}
const { p, nivel = 'h3', vt = false, datos = true, marca = false, categoria = false, linea = 'resumen', sizes = '(min-width: 1200px) 370px, (min-width: 900px) 30vw, (min-width: 640px) 46vw, 88vw', priority = false, traits = true } = Astro.props;
const url = urlFicha(p);
const c = CAT[p.categoria];
const H = nivel;
const id = `pc-${p.slug}`;
const texto = linea === 'ideal' && p.idealPara ? `Para ${p.idealPara}.` : p.resumen;
---
<article class="pc" data-halo>
  <div class="pc__media" data-rvi>
    {p.imagenes.length ? (
      <Img name={p.imagenes[0]} alt={altProducto(p)} sizes={sizes} vt={vt ? `p-${p.slug}` : undefined} priority={priority} />
    ) : (
      <div class="pc__ph" role="img" aria-label={`Ecógrafo ${p.nombre} de ${p.marca}, imagen no disponible`}>
        <svg viewBox="0 0 120 90" aria-hidden="true"><path d="M60 22 L28 70 A48 48 0 0 0 92 70 Z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M60 22 L60 70" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3"/><circle cx="60" cy="22" r="3" fill="currentColor"/></svg>
        <span>{p.marca} {p.nombre}</span>
      </div>
    )}
  </div>
  <div class="pc__body">
    {(marca || categoria) && <p class="pc__meta">{[marca && p.marca, categoria && c.corto].filter(Boolean).join(' · ')}</p>}
    <H class="pc__name" id={id}>{p.nombre}</H>
    <p class="pc__line">{texto}</p>
    {traits && !url && p.caracteristicas.length > 0 && (
      <ul class="traits">{p.caracteristicas.map((f) => <li><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg>{f.titulo}</li>)}</ul>
    )}
    {datos && p.datosClave.length > 0 && (
      <dl class="pc__data">
        {p.datosClave.slice(0, 2).map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
      </dl>
    )}
    {url ? (
      <a class="btn btn--line pc__cta" href={url} aria-describedby={id}>Ver ficha</a>
    ) : (
      <a class="btn btn--line pc__cta" href="#asesoramiento" data-want={etiquetaModelo(p)} data-equipo={c.formEquipo} data-otro={c.formOtro} aria-describedby={id}>Quiero asesoramiento</a>
    )}
  </div>
</article>
