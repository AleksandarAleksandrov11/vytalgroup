---
// Tarjeta de producto, la misma en toda la web (categorías, catálogo, gama de ecógrafos, guías y
// fichas): marca y categoría, nombre, una línea, 2 datos clave y "Ver ficha" siempre abajo. En las
// rejillas sus filas se alinean con las de las tarjetas vecinas (subgrid), así los botones quedan a
// la misma altura tenga cada equipo el texto que tenga. Imagen sin fondo sobre el escenario común; en
// escritorio la tarjeta se inclina en 3D hacia el cursor. Con `vt`, la imagen "vuela" a la ficha.
import '../styles/cards.css';
import Img from './Img.astro';
import type { Producto } from '../data/tipos';
import { CAT } from '../data/categorias';
import { urlFicha, altProducto } from '../data/productos';
import { escena } from '../lib/imagenes';
import { unidades } from '../lib/texto';

interface Props {
  p: Producto;
  nivel?: 'h2' | 'h3';
  vt?: boolean;
  linea?: 'resumen' | 'ideal';
  sizes?: string;
  priority?: boolean;
  /** Sufijo para ids únicos si el mismo equipo aparece dos veces en una página */
  sufijo?: string;
}
const { p, nivel = 'h3', vt = false, linea = 'resumen', sizes = '(min-width: 1200px) 370px, (min-width: 900px) 30vw, (min-width: 640px) 46vw, 82vw', priority = false, sufijo = '' } = Astro.props;
const url = urlFicha(p)!;
const c = CAT[p.categoria];
const H = nivel;
const id = `pc-${p.slug}${sufijo}`;
const texto = linea === 'ideal' && p.idealPara ? `Para ${p.idealPara}.` : p.resumen;
---
<article class="pc lift" data-tilt>
  <div class="pc__media stage" style={escena(p.imagenes[0])} data-rvi>
    <Img name={p.imagenes[0]} alt={altProducto(p)} sizes={sizes} vt={vt ? `p-${p.slug}` : undefined} priority={priority} />
  </div>
  <p class="pc__meta"><span>{p.marca}</span><span>{c.corto}</span></p>
  <H class="pc__name" id={id}>{p.nombre}</H>
  <p class="pc__line">{texto}</p>
  <dl class="pc__data">
    {p.datosClave.slice(0, 2).map((d) => <div><dt>{d.etiqueta}</dt><dd>{unidades(d.valor)}</dd></div>)}
  </dl>
  <a class="btn btn--line pc__cta" href={url} aria-describedby={id} data-fill>Ver ficha<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
</article>
