---
// Las 3 razones de VytalGroup: te asesoran fisioterapeutas, 2 años de garantía y mantenimiento claro.
// Variante "fila" para la ficha de producto ("Garantía y servicio").
interface Props { fila?: boolean; nivel?: 'h3' | 'h4' }
const { fila = false, nivel = 'h3' } = Astro.props;
const H = nivel;
const RAZONES = [
  { icono: 'i-users', t: 'Te asesoran fisioterapeutas', d: 'Te recomendamos lo que encaja con tu forma de trabajar, sin venderte lo que no necesitas.' },
  { icono: 'i-shield', t: '2 años de garantía', d: 'En piezas y mano de obra, por escrito.' },
  { icono: 'i-tool', t: 'Mantenimiento claro', d: 'Sabes lo que incluye desde el primer día. Sin sorpresas.' },
];
---
<ul class:list={['rs', { 'rs--row': fila }]}>
  {RAZONES.map((r, i) => (
    <li class="rs__item" data-rv style={`--rd:${i * 80}ms`}>
      <span class="rs__ico" aria-hidden="true"><svg class="icon"><use href={`#${r.icono}`}/></svg></span>
      <H class="rs__t">{r.t}</H>
      <p class="rs__d">{r.d}</p>
    </li>
  ))}
</ul>
<style is:global>
  .rs { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .rs__item { display: grid; justify-items: start; align-content: start; gap: 10px; padding: 24px; color: var(--ink); border-radius: var(--r-lg); background: #FFF; box-shadow: inset 0 0 0 1px var(--line), var(--shadow); }
  .rs__ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--teal-soft); color: var(--teal-ink); }
  .rs__ico .icon { width: 24px; height: 24px; }
  .rs__t { font-size: 1.25rem; font-weight: 560; letter-spacing: -.02em; line-height: 1.2; }
  .rs__d { font-size: .9375rem; line-height: 1.5; color: var(--ink-2); }
  @media (min-width: 768px) { .rs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  /* En fila de tres: icono, título y texto a la misma altura en las tres tarjetas */
  @supports (grid-template-rows: subgrid) { @media (min-width: 768px) { .rs:not(.rs--row) { row-gap: 10px; } .rs:not(.rs--row) .rs__item { grid-row: span 3; grid-template-rows: subgrid; } } }
  .rs--row .rs__item { grid-template-columns: auto 1fr; align-content: center; align-items: center; column-gap: 14px; row-gap: 2px; padding: 18px 20px; box-shadow: inset 0 0 0 1px var(--line); }
  .rs--row .rs__ico { grid-row: span 2; width: 44px; height: 44px; }
  .rs--row .rs__t { font-size: 1.0625rem; }
  .rs--row .rs__d { font-size: .875rem; }
</style>
