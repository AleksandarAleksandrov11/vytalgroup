---
// Quién está detrás: la foto de Javier y, al lado, su frase con la firma. Limpio, sin adornos.
import Img from './Img.astro';

interface Props { id?: string; enlace?: boolean }
const { id = 'javier', enlace = true } = Astro.props;
---
<section class="sec sec--white jv" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap jv__grid">
    <figure class="jv__photo">
      <Img name="fotos/javier-ruiz-fisioterapeuta" alt="Javier Ruiz, fisioterapeuta y fundador de VytalGroup" sizes="(min-width: 900px) 440px, (min-width: 560px) 420px, 88vw" widths={[320, 440, 600, 880, 1152]} class="jv__img" />
    </figure>
    <div class="jv__copy">
      <h2 class="h2" id={`${id}-title`} data-lines>Te asesora un <em>fisioterapeuta.</em></h2>
      <blockquote class="jv__quote" data-rv>
        <p>Me quemé en jornadas de 12 horas. Monté VytalGroup para que no te engañen.</p>
      </blockquote>
      <p class="jv__sign" data-rv><svg class="jv__sig" viewBox="0 0 3592 1230" role="img" aria-label="Firma de Javier Ruiz"><use href="#sig"/></svg><span>Javier Ruiz, fisioterapeuta y fundador</span></p>
      {enlace && <p data-rv><a class="link" href="/sobre-nosotros">Conoce la historia de Javier<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>}
    </div>
  </div>
</section>
<style is:global>
  .jv__grid { display: grid; gap: 32px; align-items: center; }
  .jv__photo { width: min(100%, 420px); margin: 0 auto; }
  .jv__photo picture { display: block; }
  .jv__img { display: block; width: 100%; height: auto; aspect-ratio: 768 / 880; object-fit: cover; object-position: 50% 20%; border-radius: var(--r-xl); box-shadow: 0 30px 60px -36px rgba(11, 25, 41, .45); }
  .jv__copy { display: grid; justify-items: center; gap: 16px; text-align: center; }
  .jv__eyebrow { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-ink); }
  .jv__quote { max-width: 30ch; margin: 4px 0 0; padding-left: 0; font-family: var(--serif); font-style: italic; font-size: clamp(1.5rem, 1.15rem + 1.3vw, 2.25rem); line-height: 1.25; letter-spacing: -.01em; color: var(--ink); }
  .jv__sign { display: grid; justify-items: center; gap: 4px; font-size: .875rem; color: var(--ink-3); }
  .jv__sig { width: 140px; height: auto; color: var(--ink); }
  @media (min-width: 900px) {
    .jv__grid { grid-template-columns: 440px minmax(0, 1fr); gap: clamp(48px, 7vw, 112px); }
    .jv__photo { width: 100%; }
    .jv__copy { justify-items: start; text-align: left; }
    .jv__copy .h2 { text-align: left; }
    .jv__quote { padding-left: 24px; border-left: 2px solid var(--teal); }
    .jv__sign { justify-items: start; }
  }
</style>
