---
// "Sin timos. Sin letra pequeña.": Javier recortado sobre un disco de color que sale de una tarjeta
// marina, su frase como cita grande con la firma y, debajo, el comparador "Lo habitual / Con VytalGroup".
import Img from './Img.astro';
import Comparator from './Comparator.astro';

interface Props { comparador?: boolean; id?: string; enlace?: boolean }
const { comparador = true, id = 'sin-timos', enlace = true } = Astro.props;
---
<section class="sec jv" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <div class="jv__card">
      <div class="jv__glow" aria-hidden="true"></div>
      <figure class="jv__portrait" data-rv>
        <span class="jv__disc" aria-hidden="true"></span>
        <svg class="jv__ring" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="97" /></svg>
        <Img name="fotos/javier-ruiz-fisioterapeuta-recorte" alt="Javier Ruiz, fisioterapeuta y fundador de VytalGroup" sizes="(min-width: 1024px) 420px, (min-width: 768px) 340px, 300px" widths={[300, 420, 600, 768]} class="jv__img" />
        <figcaption class="jv__tags">
          <span class="jv__tag jv__tag--a">Fisioterapeuta</span>
          <span class="jv__tag jv__tag--b">Fundador de VytalGroup</span>
        </figcaption>
      </figure>
      <div class="jv__copy">
        <p class="jv__eyebrow" data-rv>Quién está detrás</p>
        <h2 class="h2" id={`${id}-title`} data-lines>Sin timos. <em>Sin letra pequeña.</em></h2>
        <blockquote class="jv__quote" data-rv>
          <p>Me quemé en jornadas de 12 horas. <span>Monté VytalGroup para que no te engañen.</span></p>
        </blockquote>
        <p class="jv__sign" data-rv><svg class="jv__sig" viewBox="0 0 3592 1230" role="img" aria-label="Firma de Javier Ruiz"><use href="#sig"/></svg><span>Javier Ruiz · fisioterapeuta y fundador</span></p>
        {enlace && <p data-rv><a class="link on-dark-link" href="/sobre-nosotros">Conoce la historia de Javier<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>}
      </div>
    </div>
    {comparador && (
      <div class="jv__cmp">
        <div class="sec__head">
          <h3 class="h2 jv__cmp-title" data-lines>Lo habitual, <em>y lo nuestro.</em></h3>
        </div>
        <Comparator />
      </div>
    )}
    <div class="sec__cta" data-rv>
      <a class="btn btn--primary" href="#asesoramiento" data-cta data-magnetic>Quiero asesoramiento</a>
    </div>
  </div>
</section>
<style is:global>
  .jv { isolation: isolate; background: var(--bg); }
  .jv__card { position: relative; display: grid; justify-items: center; gap: 8px; margin-top: 64px; padding: 0 20px 36px; border-radius: 32px; color: #FFF; background-color: var(--navy); background-image: radial-gradient(120% 90% at 85% 0%, #1B4A63 0%, var(--navy-2) 45%, var(--navy) 100%); box-shadow: 0 40px 80px -48px rgba(11, 25, 41, .7); }
  .jv__card :focus-visible { outline-color: #FFF; }
  .jv__glow { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; pointer-events: none; }
  .jv__glow::before { content: ""; position: absolute; width: 520px; height: 520px; right: -160px; bottom: -220px; border-radius: 50%; background: radial-gradient(circle, rgba(72, 160, 168, .35) 0%, transparent 65%); }
  .jv__glow::after { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(255, 255, 255, .08) 1px, transparent 1.4px); background-size: 20px 20px; -webkit-mask-image: linear-gradient(90deg, transparent, #000 60%); mask-image: linear-gradient(90deg, transparent, #000 60%); }
  /* Retrato: Javier recortado, de pie sobre un disco que sobresale por arriba de la tarjeta */
  .jv__portrait { position: relative; width: min(84vw, 320px); aspect-ratio: 768 / 880; margin-top: -64px; }
  .jv__disc { position: absolute; left: 6%; right: 6%; bottom: 6%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #8FDCDC 0%, #48A0A8 48%, #2B7D86 100%); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .6); }
  .jv__ring { position: absolute; left: 1%; right: 1%; bottom: 1%; width: 98%; height: auto; aspect-ratio: 1; fill: none; stroke: rgba(143, 220, 220, .55); stroke-width: .8; stroke-dasharray: 3 6; }
  .jv__img { position: relative; width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; -webkit-mask-image: linear-gradient(180deg, #000 82%, transparent 100%); mask-image: linear-gradient(180deg, #000 82%, transparent 100%); }
  .jv__portrait picture { position: absolute; inset: 0; }
  .jv__tags { position: absolute; inset: 0; pointer-events: none; }
  .jv__tag { position: absolute; padding: 8px 14px; border-radius: 999px; background: #FFF; color: var(--ink); font-size: .8125rem; font-weight: 560; letter-spacing: -.01em; white-space: nowrap; box-shadow: 0 14px 30px -16px rgba(0, 0, 0, .55); }
  .jv__tag--a { left: -4%; top: 44%; }
  .jv__tag--b { right: -6%; top: 64%; background: var(--teal); }
  .jv__copy { position: relative; display: grid; justify-items: center; gap: 18px; max-width: 620px; text-align: center; }
  .jv__eyebrow { font-size: .75rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-on-dark); }
  .jv__copy .h2 { color: #FFF; }
  .jv__copy .h2 em { display: block; color: var(--teal-light); }
  .jv__quote { position: relative; margin: 6px 0 0; padding-top: 34px; font-size: clamp(1.3125rem, 1.05rem + 1.1vw, 1.875rem); line-height: 1.3; letter-spacing: -.02em; color: rgba(255, 255, 255, .92); }
  .jv__quote::before { content: "“"; position: absolute; left: 50%; top: -18px; translate: -50% 0; font: italic 400 5.5rem/1 var(--serif); color: var(--teal); }
  .jv__quote span { display: block; font-family: var(--serif); font-style: italic; color: var(--teal-light); font-size: 1.12em; }
  .jv__sign { display: grid; justify-items: center; gap: 4px; font-size: .8125rem; color: var(--on-dark-2); }
  .jv__sig { width: 150px; height: auto; color: #FFF; }
  @media (min-width: 768px) {
    .jv__card { grid-template-columns: minmax(260px, 340px) minmax(0, 1fr); justify-items: stretch; align-items: end; gap: 24px 48px; margin-top: 88px; padding: 0 48px 0 32px; }
    .jv__portrait { width: 100%; margin-top: -88px; }
    .jv__copy { justify-items: start; padding: 56px 0; text-align: left; }
    .jv__quote { padding-top: 38px; }
    .jv__quote::before { left: -6px; translate: 0 0; }
    .jv__sign { justify-items: start; }
  }
  @media (min-width: 1024px) { .jv__card { grid-template-columns: 420px minmax(0, 1fr); column-gap: clamp(48px, 6vw, 96px); padding-right: 64px; } }
  @media (prefers-reduced-motion: no-preference) {
    /* Gira el círculo y no el SVG: así la caja no crece al rotar ni desborda en móviles estrechos */
    .jv__ring circle { animation: hx-spin 50s linear infinite; transform-box: view-box; transform-origin: 50% 50%; }
    .jv__portrait.rv .jv__disc { transform: scale(.7); opacity: 0; }
    .jv__portrait.rv .jv__img, .jv__portrait.rv .jv__tag { opacity: 0; transform: translateY(24px); }
    .jv__portrait.rv.is-in .jv__disc { transform: none; opacity: 1; transition: transform 1s var(--ease), opacity .6s ease; }
    .jv__portrait.rv.is-in .jv__img { opacity: 1; transform: none; transition: opacity .8s var(--ease) .2s, transform 1s var(--ease) .2s; }
    .jv__portrait.rv.is-in .jv__tag { opacity: 1; transform: none; transition: opacity .6s ease, transform .8s var(--ease); }
    .jv__portrait.rv.is-in .jv__tag--a { transition-delay: .55s; }
    .jv__portrait.rv.is-in .jv__tag--b { transition-delay: .7s; }
    .jv__tag--a { animation: jv-float 6s ease-in-out 1.6s infinite; }
    .jv__tag--b { animation: jv-float 7s ease-in-out 2s infinite reverse; }
  }
  @keyframes jv-float { 50% { translate: 0 -6px; } }
  .jv__cmp { margin-top: clamp(64px, 8vw, 110px); }
  .jv__cmp-title em { color: var(--teal-ink); }
</style>
