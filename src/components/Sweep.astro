---
// Barrido de ecografía: sector en abanico sutil con una línea que barre de lado a lado y arcos de
// profundidad. SVG decorativo; con movimiento reducido queda quieto.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['sweep', cls]} viewBox="0 0 400 300" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sw-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8FDCDC" stop-opacity=".55" />
      <stop offset="1" stop-color="#8FDCDC" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="sw-f" cx="200" cy="10" r="290" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#48A0A8" stop-opacity=".16" />
      <stop offset="1" stop-color="#48A0A8" stop-opacity="0" />
    </radialGradient>
  </defs>
  <path class="sweep__fan" d="M200 10 L58 262 A290 290 0 0 0 342 262 Z" fill="url(#sw-f)" />
  <g class="sweep__arcs" fill="none" stroke="#8FDCDC" stroke-opacity=".18" stroke-width="1">
    <path d="M149 100 A105 105 0 0 0 251 100" />
    <path d="M121 150 A162 162 0 0 0 279 150" />
    <path d="M93 200 A219 219 0 0 0 307 200" />
    <path d="M58 262 A290 290 0 0 0 342 262" />
  </g>
  <g class="sweep__beam">
    <path d="M200 10 L186 286 L214 286 Z" fill="url(#sw-g)" />
    <line x1="200" y1="10" x2="200" y2="290" stroke="#8FDCDC" stroke-opacity=".7" stroke-width="1.2" />
  </g>
</svg>
<style is:global>
  .sweep { display: block; width: 100%; height: auto; overflow: visible; }
  .sweep__beam { transform-box: view-box; transform-origin: 200px 10px; transform: rotate(-26deg); }
  @media (prefers-reduced-motion: no-preference) {
    .sweep__beam { animation: sweep 5.5s cubic-bezier(.45, 0, .55, 1) infinite alternate; }
    .sweep__arcs { animation: sweep-arcs 5.5s ease-in-out infinite alternate; }
  }
  @keyframes sweep { from { transform: rotate(-26deg); } to { transform: rotate(26deg); } }
  @keyframes sweep-arcs { from { opacity: .6; } to { opacity: 1; } }
</style>
