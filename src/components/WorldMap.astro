---
// Mapa de alcance: los países de América y Europa (Natural Earth, src/assets/mapa/alcance-tierra.svg, con los
// países con envío algo más claros) y encima, en el mismo lienzo, un punto por destino: países de la UE, seis
// estados de EE. UU. y cada país de Latinoamérica, con España como origen. Al entrar en pantalla, las rutas
// salen de España y los puntos se encienden de más cerca a más lejos. Se genera con scripts/mapa/generar-alcance.mjs.
import tierraUrl from '../assets/mapa/alcance-tierra.svg?url';
import { ALCANCE, ORIGEN, UE, USA, LATAM } from '../data/alcance';

const { w: W, h: H } = ALCANCE;
const [ox, oy] = ORIGEN.xy;
const lejos = (xy: [number, number]) => Math.hypot(xy[0] - ox, xy[1] - oy);
const destinos = [
  ...UE.map((p) => ({ ...p, zona: 'ue' })),
  ...USA.map((p) => ({ ...p, zona: 'usa' })),
  ...LATAM.map((p) => ({ ...p, zona: 'latam' })),
].map((p) => ({ ...p, t: Math.round((lejos(p.xy) / W) * 1400) }));
// Rutas solo a unos destinos de referencia por región (con una a cada país el mapa se ensucia)
const CON_RUTA = new Set(['California', 'Texas', 'Nueva York', 'México', 'Colombia', 'Brasil', 'Argentina', 'Chile']);
// Ruta desde España: curva suave hacia arriba, más alta cuanto más lejos va
const ruta = ([x, y]: [number, number]) => {
  const d = Math.hypot(x - ox, y - oy);
  return `M${ox} ${oy}Q${Math.round((ox + x) / 2)} ${Math.round(Math.min(oy, y) - d * 0.16)} ${x} ${y}`;
};
const ZONAS = [
  { t: 'Estados Unidos', xy: [250, 112] },
  { t: 'Unión Europea', xy: [1040, 24] },
  { t: 'Latinoamérica', xy: [700, 900] },
];
const lista = (ps: { nombre: string }[]) => ps.map((p) => p.nombre).join(', ');
---
<figure class="am" data-map style={`--ar:${W} / ${H}`}>
  <img class="am__tierra" src={tierraUrl} width={W} height={H} alt="" loading="lazy" decoding="async">
  <svg class="am__capa" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <g class="am__rutas">
      {destinos.filter((p) => CON_RUTA.has(p.nombre)).map((p) => <path d={ruta(p.xy)} pathLength="1" style={`--t:${p.t}ms`} />)}
    </g>
    {ZONAS.map((z) => <text class="am__zona" x={z.xy[0]} y={z.xy[1]} text-anchor="middle">{z.t}</text>)}
    <g class="am__puntos">
      {destinos.map((p) => (
        <g class={`am__p am__p--${p.zona}`} style={`--t:${p.t}ms`}>
          <title>{p.nombre}</title>
          <circle class="am__halo" cx={p.xy[0]} cy={p.xy[1]} r="13" />
          <circle class="am__dot" cx={p.xy[0]} cy={p.xy[1]} r="5.5" />
        </g>
      ))}
      <g class="am__o">
        <title>{ORIGEN.nombre}</title>
        <circle class="am__ring" cx={ox} cy={oy} r="16" />
        <circle class="am__dot" cx={ox} cy={oy} r="7.5" />
      </g>
    </g>
  </svg>
  <figcaption class="sr-only">Mapa de envíos desde España a la Unión Europea ({lista(UE)}), a Estados Unidos ({lista(USA)}) y a Latinoamérica ({lista(LATAM)}).</figcaption>
</figure>
<style is:global>
  .am { position: relative; margin: 0; width: 100%; aspect-ratio: var(--ar); }
  /* Los países se recortan en el borde del lienzo: se difuminan hacia el marino para que no haya cortes rectos */
  .am__tierra { position: absolute; inset: 0; width: 100%; height: 100%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 92%, transparent), linear-gradient(180deg, transparent, #000 9%, #000 94%, transparent); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 5%, #000 92%, transparent), linear-gradient(180deg, transparent, #000 9%, #000 94%, transparent); mask-composite: intersect; }
  .am__capa { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .am__rutas path { fill: none; stroke: var(--teal-on-dark); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-linecap: round; opacity: .45; }
  .am__zona { fill: rgba(255, 255, 255, .86); font: 600 26px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .am__p circle, .am__o circle { transform-box: fill-box; transform-origin: center; }
  .am__dot { fill: var(--teal-light); }
  .am__halo { fill: var(--teal-light); opacity: .16; }
  .am__o .am__dot { fill: #FFF; }
  .am__ring { fill: none; stroke: #FFF; stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: .5; }
  .am__p:hover .am__dot { fill: #FFF; }
  /* En móvil el mapa es pequeño: puntos algo más grandes y sin nombres de zona (van en la leyenda) */
  @media (max-width: 639px) {
    .am__p circle, .am__o circle { scale: 1.45; }
    .am__zona { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .am__tierra { opacity: 0; transform: scale(.985); transition: opacity 1s var(--ease), transform 1.2s var(--ease); }
    .am__rutas path { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .am__p { opacity: 0; }
    .am__p .am__dot { transform: scale(0); }
    .am__zona { opacity: 0; transition: opacity .8s var(--ease) 1.2s; }
    .am.is-on .am__tierra { opacity: 1; transform: none; }
    .am.is-on .am__rutas path { stroke-dashoffset: 0; transition: stroke-dashoffset 1.4s var(--ease); transition-delay: calc(250ms + var(--t)); }
    .am.is-on .am__p { opacity: 1; transition: opacity .5s var(--ease); transition-delay: calc(700ms + var(--t)); }
    .am.is-on .am__p .am__dot { transform: none; transition: transform .6s cubic-bezier(.34, 1.56, .64, 1); transition-delay: calc(700ms + var(--t)); }
    .am.is-on .am__zona { opacity: 1; }
    .am.is-on .am__ring { animation: am-pulse 2.4s var(--ease) .2s 4; }
  }
  @keyframes am-pulse { 0% { opacity: .8; transform: scale(.5); } 80%, 100% { opacity: 0; transform: scale(2.4); } }
</style>
