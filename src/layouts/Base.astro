---
// Layout común de todas las páginas: SEO (title, description, canonical, Open Graph, Twitter),
// JSON-LD, fuentes precargadas, sprite, cabecera, pie, barra móvil, cookies y el JS de la web.
import '../styles/base.css';
import '../styles/hero.css';
import geistUrl from '../assets/fonts/geist.woff2?url';
import serifUrl from '../assets/fonts/instrument-serif-italic.woff2?url';
// Script del <head> que decide la intro de marca antes de pintar (externo y con hash: CSP y caché inmutable).
// Solo la primera vez que se abre la web en el navegador y sin movimiento reducido pone <html class="con-intro"> y
// guarda vg_intro en localStorage; sin almacenamiento no hay intro (así nunca se repite).
import introUrl from '../scripts/intro-head.js?url';
import { SHEETS_ENDPOINT, SITE_URL, VERCEL_ANALYTICS, GOOGLE_SITE_VERIFICATION } from '../config';
import Sprite from '../components/Sprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Cookies from '../components/Cookies.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { absUrl, breadcrumbList, graph, organization, type Miga, website, persona } from '../lib/seo';

export type Seccion = 'inicio' | 'ecografos' | 'diatermias' | 'equipos' | 'catalogo' | 'sobre-nosotros' | 'contacto' | 'guias' | 'legal' | '';

interface Props {
  title: string;
  description: string;
  path: string;
  og?: string;
  ogAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  jsonld?: object[];
  migas?: Miga[];
  seccion?: Seccion;
  conFormulario?: boolean;
  lectura?: boolean;
  bodyClass?: string;
  /** Mensaje ya escrito del botón flotante de WhatsApp (por defecto, uno general) */
  waTexto?: string;
}
const {
  title, description, path, og = '/og/inicio.jpg', ogAlt, ogType = 'website', jsonld = [], migas,
  seccion = '', conFormulario = true, lectura = false, bodyClass, waTexto,
} = Astro.props;

const canonical = absUrl(path);
const ogUrl = absUrl(og);
const nodos = [...jsonld];
if (migas?.length) nodos.push(breadcrumbList(migas));
if (!nodos.some((n: any) => n['@type'] === 'Organization')) nodos.push(organization());
if (!nodos.some((n: any) => n['@type'] === 'WebSite')) nodos.push(website());
if (!nodos.some((n: any) => n['@type'] === 'Person')) nodos.push(persona());
---
<!doctype html>
<html lang="es" data-sheets={SHEETS_ENDPOINT} data-analytics={VERCEL_ANALYTICS ? '1' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<script is:inline src={introUrl}></script>
<title>{title}</title>
<meta name="description" content={description}>
{path !== '/404' && <link rel="canonical" href={canonical}>}
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="theme-color" content="#FAFBFC">
<meta name="format-detection" content="telephone=no">
{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION}>}
<meta property="og:type" content={ogType === 'product' ? 'website' : ogType}>
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="VytalGroup">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{path !== '/404' && <meta property="og:url" content={canonical}>}
<meta property="og:image" content={ogUrl}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt || title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogUrl}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin>
<slot name="head" />
<script type="application/ld+json" set:html={graph(nodos)} />
<noscript><style>[data-js-only] { display: none !important; }</style></noscript>
</head>
<body class={bodyClass} data-site={SITE_URL}>
<Sprite />
<!-- Intro de marca a pantalla completa: solo se ve con <html class="con-intro"> (primera visita; ver intro-head.js) -->
<div class="intro" data-intro aria-hidden="true">
  <div class="intro__in">
    <div class="intro__logo">
      <svg class="intro__mark" viewBox="0 0 214 171"><use href="#logo" width="1117" height="171"/></svg>
      <svg class="intro__word" viewBox="270 0 847 171"><use href="#logo" width="1117" height="171"/></svg>
    </div>
    <span class="intro__line"></span>
  </div>
</div>
<a class="skip" href="#main">Saltar al contenido</a>
<Header seccion={seccion} conFormulario={conFormulario} path={path} />
{lectura && <div class="read-progress" data-read-progress aria-hidden="true"><span></span></div>}
<main id="main" tabindex="-1">
  <slot />
</main>
<Footer conFormulario={conFormulario} />
<MobileBar conFormulario={conFormulario} />
<WhatsAppFloat texto={waTexto} />
<Cookies />
<script>
  import '../scripts/main';
</script>
</body>
</html>
