---
// Layout común de todas las páginas: SEO (title, description, canonical, Open Graph, Twitter),
// JSON-LD, fuentes precargadas, sprite, cabecera, pie, barra móvil, cookies y el JS de la web.
import '../styles/base.css';
import geistUrl from '../assets/fonts/geist.woff2?url';
import serifUrl from '../assets/fonts/instrument-serif-italic.woff2?url';
import { SHEETS_ENDPOINT, META_PIXEL_ID, SITE_URL, VERCEL_ANALYTICS } from '../config';
import Sprite from '../components/Sprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Cookies from '../components/Cookies.astro';
import { absUrl, breadcrumbList, graph, organization, type Miga } from '../lib/seo';

export type Seccion = 'inicio' | 'ecografos' | 'diatermias' | 'equipos' | 'catalogo' | 'sobre-nosotros' | 'contacto' | 'guias' | 'legal' | '';

interface Props {
  title: string;
  description: string;
  path: string;
  og?: string;
  ogAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  jsonld?: object[];
  migas?: Miga[];
  seccion?: Seccion;
  conFormulario?: boolean;
  /** ViewContent del píxel en fichas y páginas pilar */
  viewContent?: { ids?: string[]; type: string; category: string; name: string };
  lectura?: boolean;
  bodyClass?: string;
}
const {
  title, description, path, og = '/og/inicio.jpg', ogAlt, ogType = 'website', noindex = false, jsonld = [], migas,
  seccion = '', conFormulario = true, viewContent, lectura = false, bodyClass,
} = Astro.props;

const canonical = absUrl(path);
const ogUrl = absUrl(og);
const nodos = [...jsonld];
if (migas?.length) nodos.push(breadcrumbList(migas));
if (!nodos.some((n: any) => n['@type'] === 'Organization')) nodos.push(organization());
---
<!doctype html>
<html lang="es" data-sheets={SHEETS_ENDPOINT} data-pixel={META_PIXEL_ID} data-analytics={VERCEL_ANALYTICS ? '1' : undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}>
<meta name="theme-color" content="#FAFBFC">
<meta name="format-detection" content="telephone=no">
<meta property="og:type" content={ogType === 'product' ? 'website' : ogType}>
<meta property="og:locale" content="es_ES">
<meta property="og:site_name" content="VytalGroup">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogUrl}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt || title}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogUrl}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin>
<slot name="head" />
<script type="application/ld+json" set:html={graph(nodos)} />
<noscript><style>[data-js-only] { display: none !important; }</style></noscript>
</head>
<body class={bodyClass} data-vc={viewContent ? JSON.stringify(viewContent) : undefined} data-site={SITE_URL}>
<Sprite />
<a class="skip" href="#main">Saltar al contenido</a>
<Header seccion={seccion} conFormulario={conFormulario} path={path} />
{lectura && <div class="read-progress" data-read-progress aria-hidden="true"><span></span></div>}
<main id="main" tabindex="-1">
  <slot />
</main>
<Footer conFormulario={conFormulario} />
<MobileBar conFormulario={conFormulario} />
<Cookies />
<script>
  import '../scripts/main';
</script>
</body>
</html>
