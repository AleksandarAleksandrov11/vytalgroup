---
// Página pilar de ecografía: hero, cómo elegir en 3 preguntas, selector por tipo, comparativa,
// ecografía + electrólisis percutánea, por qué VytalGroup, preguntas frecuentes y formulario.
import '../../styles/pilar.css';
import '../../styles/cards.css';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import { escena } from '../../lib/imagenes';
import ProductCard from '../../components/ProductCard.astro';
import CompareTable from '../../components/CompareTable.astro';
import Reasons from '../../components/Reasons.astro';
import Faq from '../../components/Faq.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { CAT } from '../../data/categorias';
import { deCategoria, producto, urlFicha } from '../../data/productos';
import { COMPARATIVA_ECOGRAFOS } from '../../data/comparativas';
import { FAQ_ECOGRAFIA } from '../../data/faqs';
import { collectionPage, faqPage, itemList } from '../../lib/seo';

const c = CAT.ecografia;
const todos = deCategoria('ecografia');
// Pestañas por formato (los ids casan con los enlaces del menú móvil: /ecografos#gama-portatil)
const tipos = [
  { id: 'inalambrico', label: 'De bolsillo', items: todos.filter((p) => p.formato === 'inalambrico') },
  { id: 'portatil', label: 'Portátiles', items: todos.filter((p) => p.formato === 'portatil') },
  { id: 'carro', label: 'De carro', items: todos.filter((p) => p.formato === 'carro') },
];
const physio = producto('physio-invasiva-2-0');
const migas = [{ name: 'Inicio', href: '/' }, { name: 'Ecógrafos', href: '/ecografos' }];
const PREGUNTAS = [
  { n: '01', q: '¿Dónde trabajas?', a: 'En consulta, a domicilio o en campo. Si te mueves mucho, una sonda inalámbrica; si trabajas en un sitio fijo, un portátil o un carro.' },
  { n: '02', q: '¿Qué procedimientos haces?', a: 'Ecoguiados, exploración musculoesquelética, vascular... Cada modelo tiene sus aplicaciones, y las verás en su ficha.' },
  { n: '03', q: '¿Cuántas sondas necesitas?', a: 'Desde 1 puerto activo en la AX2 hasta 4 en el U2 y 5 en la LX3, la LX9 y la LX85. Si usas varias a diario, cuenta puertos.' },
];
---
<Base
  title={c.seoTitle}
  description={c.seoDescription}
  path="/ecografos"
  og="/og/ecografos.jpg"
  seccion="ecografos"
  migas={migas}
  jsonld={[collectionPage('/ecografos', 'Ecógrafos para fisioterapia'), itemList('Ecógrafos', todos), faqPage(FAQ_ECOGRAFIA)]}
  viewContent={{ ids: todos.map((p) => p.slug), type: 'product_group', category: 'Ecografía', name: 'Ecógrafos' }}
  waTexto="Hola, vengo de la web de VytalGroup y quiero información sobre ecógrafos. ¿Me podéis asesorar?"
>
  <PageHero migas={migas} titulo={c.h1} lead="Inalámbricos, portátiles y de carro para fisioterapia y medicina. Te ayudamos a elegir el que encaja con tu forma de trabajar." imagen="ecografo-portatil-acclarix-ax8-edan" alt="Ecógrafo portátil Acclarix AX8 de EDAN con doble pantalla táctil">
    <Fragment slot="acciones">
      <a class="btn btn--primary btn--lg" href="#asesoramiento" data-cta data-magnetic>Quiero asesoramiento</a>
      <a class="link" href="#gama">Ver los {todos.length} ecógrafos<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </Fragment>
  </PageHero>

  <section class="sec sec--mist gama-sec" id="gama" aria-labelledby="gama-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="gama-title" data-lines>Ecógrafos portátiles, de bolsillo <em>y de carro.</em></h2>
        <p class="lead" data-rv>{todos.length} ecógrafos en tres formatos: de bolsillo e inalámbricos, portátiles y de carro.</p>
        <div class="seg seg--3 seg--count" role="tablist" aria-label="Formato de ecógrafo" data-seg data-rv>
          <span class="seg__ind" aria-hidden="true"></span>
          {tipos.map((t, i) => (
            <button class="seg__btn" type="button" role="tab" id={`gama-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${t.label}, ${t.items.length} ${t.items.length === 1 ? 'equipo' : 'equipos'}`} tabindex={i === 0 ? undefined : '-1'} data-n={t.items.length}>{t.label}</button>
          ))}
        </div>
      </div>
      <div class="panels" data-rv>
        {tipos.map((t, i) => (
          <div class:list={['panel', { 'is-active': i === 0 }]} role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`gama-${t.id}`} inert={i !== 0}>
            <div class:list={['gama', { 'gama--few': t.items.length <= 3 }]} data-carousel>
              <ul class="rail gama__rail" data-rail>
                {t.items.map((p) => <li><ProductCard p={p} vt sizes="(min-width: 1200px) 360px, (min-width: 900px) 30vw, 78vw" /></li>)}
              </ul>
              {t.items.length > 3 && (
                <>
                  <button class="gama__arrow gama__arrow--prev" type="button" aria-label="Ver los anteriores" data-prev disabled><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
                  <button class="gama__arrow gama__arrow--next" type="button" aria-label="Ver los siguientes" data-next><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
                </>
              )}
            </div>
            {t.items.length > 1 && <div class="dots" aria-hidden="true">{t.items.map((_, j) => <span class:list={{ 'is-on': j === 0 }}></span>)}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--white" aria-labelledby="elegir-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="elegir-title" data-lines>Cómo elegir en <em>3 preguntas.</em></h2>
      </div>
      <ol class="qs">
        {PREGUNTAS.map((p, i) => (
          <li class="qs__item" data-rv data-tilt style={`--rd:${i * 80}ms`}>
            <span class="qs__n" aria-hidden="true">{p.n}</span>
            <h3 class="qs__q">{p.q}</h3>
            <p class="qs__a">{p.a}</p>
          </li>
        ))}
      </ol>
      <div class="sec__cta" data-rv>
        <a class="btn btn--line" href="/guias/como-elegir-un-ecografo-para-fisioterapia">Leer la guía para elegir ecógrafo</a>
      </div>
    </div>
  </section>

  <section class="sec sec--grid" id="comparativa" aria-labelledby="cmp-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="cmp-title" data-lines>Compara los <em>ecógrafos.</em></h2>
        <p class="lead" data-rv>Formato, pantalla, puertos de sonda y batería de cada modelo, con los datos del catálogo.</p>
      </div>
      <CompareTable columnas={COMPARATIVA_ECOGRAFOS.columnas} filas={COMPARATIVA_ECOGRAFOS.filas} caption="Comparativa de ecógrafos: formato y peso, monitor, puertos de sonda, batería e ideal para" />
    </div>
  </section>

  <section class="sec sec--teal combo" aria-labelledby="combo-title">
    <div class="wrap combo__grid">
      <div class="combo__media stage lift" style={escena(physio.imagenes[0])} data-rvi><Img name={physio.imagenes[0]} alt="Equipo de electrólisis percutánea ecoguiada Physio Invasiva 2.0 de EasyTech" sizes="(min-width: 900px) 520px, 88vw" widths={[320, 480]} parallax /></div>
      <div class="combo__copy">
        <h2 class="h2" id="combo-title" data-lines>Ecografía y electrólisis, <em>mejor juntas.</em></h2>
        <p class="lead" data-rv>La electrólisis percutánea ecoguiada (USGET) se hace con guía ecográfica. Physio Invasiva 2.0 de EasyTech reúne galvánica, PES, microcorrientes y TENS en 1,05 kg, y trabaja junto a un portátil o a la sonda inalámbrica.</p>
        <div class="combo__cta" data-rv>
          <a class="btn btn--dark" href={urlFicha(physio)}>Ver Physio Invasiva 2.0<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--photo on-dark" aria-labelledby="porque-title">
    <div class="sec__photo" aria-hidden="true"><Img name="fotos/fondo-ecografo-en-consulta" alt="Consulta médica con equipamiento de diagnóstico" sizes="(max-width: 767px) 250vw, (max-width: 1023px) 150vw, 100vw" widths={[640, 1080, 1600, 2000]} quality={62} /></div>
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="porque-title" data-lines>Por qué comprar tu ecógrafo <em>con VytalGroup.</em></h2>
      </div>
      <Reasons />
      <div class="sec__cta" data-rv>
        <a class="btn btn--primary" href="#asesoramiento" data-cta data-magnetic>Quiero asesoramiento</a>
        <a class="link" href="/guias/que-revisar-antes-de-comprar-un-equipo-medico">Qué revisar antes de comprar<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>

  <Faq faqs={FAQ_ECOGRAFIA} titulo="Dudas sobre *ecografía.*" id="dudas-ecografia" />

  <CtaFinal preset={{ equipo: 'Ecógrafo' }} subtitulo="Cuéntanos cómo trabajas y te recomendamos el ecógrafo y las sondas que encajan." />
</Base>
