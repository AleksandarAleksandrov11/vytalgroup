---
// Página de cada categoría del catálogo (salvo ecografía y diatermia, que tienen su pilar):
// hero con la palabra clave, línea de apoyo, tarjetas de sus productos, qué es y para qué se usa,
// preguntas frecuentes si hay información y el formulario con la categoría preseleccionada.
import '../../../styles/cards.css';
import '../../../styles/pilar.css';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Img from '../../../components/Img.astro';
import { escena } from '../../../lib/imagenes';
import ProductCard from '../../../components/ProductCard.astro';
import Faq from '../../../components/Faq.astro';
import CtaFinal from '../../../components/CtaFinal.astro';
import { CATEGORIAS, nombresCat, type Categoria } from '../../../data/categorias';
import { deCategoria, PRODUCTOS, altProducto } from '../../../data/productos';
import { acento, enlaces } from '../../../lib/texto';
import { faqsCategoria } from '../../../data/faqs';
import CompareTable from '../../../components/CompareTable.astro';
import { COMPARATIVA_CAMILLAS } from '../../../data/comparativas';

// H2 de "qué es", con la palabra clave de cada categoría
// "El equipo de *diatermia por microondas.*", "Los 15 equipos de *ecografía.*", "Las 6 *camillas.*"
const conAcento = (s: string, tema: string) => (s.endsWith(tema) ? `${s.slice(0, s.length - tema.length)}*${tema}.*` : `*${s}.*`);
const QUE: Record<string, string> = {
  'ondas-de-choque': 'Qué son las ondas de choque *y para qué se usan.*',
  magnetoterapia: 'Qué es la magnetoterapia *y para qué se usa.*',
  laser: 'Qué es el láser terapéutico *y para qué se usa.*',
  'electrolisis-percutanea': 'Qué es la electrólisis percutánea *y para qué se usa.*',
  electroterapia: 'Qué es la electroterapia *y para qué se usa.*',
  ultrasonidos: 'Qué son los ultrasonidos terapéuticos *y para qué se usan.*',
  presoterapia: 'Qué es la presoterapia *y para qué se usa.*',
  'diatermia-microondas': 'Qué es la diatermia por microondas *y para qué se usa.*',
  camillas: 'Cómo elegir camilla *de fisioterapia.*',
  'estetica-medica': 'Qué tecnologías incluye *la línea de estética.*',
};
import { collectionPage, faqPage, itemList } from '../../../lib/seo';

export function getStaticPaths() {
  return CATEGORIAS.filter((c) => !c.pilar).map((c) => ({ params: { categoria: c.id }, props: { c } }));
}
interface Props { c: Categoria }
const { c } = Astro.props;
const productos = deCategoria(c.id);
const migas = [{ name: 'Inicio', href: '/' }, { name: 'Equipos', href: '/equipos' }, { name: c.nombre, href: c.ruta }];
const jsonld: object[] = [collectionPage(c.ruta, c.nombre), itemList(c.nombre, productos)];
const faqs = faqsCategoria(c, productos);
jsonld.push(faqPage(faqs));
const n = productos.length;
const nom = nombresCat(c);
const tituloLista = n === 1 ? `${nom.f ? 'La' : 'El'} ${conAcento(nom.uno, nom.tema)}` : `${nom.f ? 'Las' : 'Los'} ${n} ${conAcento(nom.varios, nom.tema)}`;
const repr = PRODUCTOS.find((p) => p.imagenes[0] === c.imagen);
const altHero = repr ? altProducto(repr) : c.nombre;
---
<Base
  title={c.seoTitle}
  description={c.seoDescription}
  path={c.ruta}
  og={`/og/${c.id}.jpg`}
  seccion="equipos"
  migas={migas}
  jsonld={jsonld}
>
  <PageHero migas={migas} titulo={c.h1} lead={c.apoyo} imagen={c.imagen} alt={altHero}>
    <Fragment slot="acciones">
      <a class="btn btn--primary btn--lg" href="#asesoramiento" data-cta data-magnetic>Quiero asesoramiento</a>
      <a class="link" href="#equipos-categoria">Ver {n === 1 ? 'el equipo' : `los ${n} equipos`}<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </Fragment>
  </PageHero>

  <section class="sec sec--white" id="equipos-categoria" aria-labelledby="eq-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="eq-title" data-lines set:html={acento(tituloLista)} />
      </div>
      <ul class:list={['grid cat-grid', { 'cat-grid--1': n === 1, 'cat-grid--2': n === 2, 'cat-grid--4': n === 4 }]}>
        {productos.map((p) => <li><ProductCard p={p} vt /></li>)}
      </ul>
    </div>
  </section>

  {c.id === 'camillas' && (
    <section class="sec sec--mist" id="comparativa" aria-labelledby="cmp-title">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="cmp-title" data-lines>Camilla eléctrica <em>o hidráulica.</em></h2>
        </div>
        <CompareTable columnas={COMPARATIVA_CAMILLAS.columnas} filas={COMPARATIVA_CAMILLAS.filas} caption="Comparativa de las camillas de fisioterapia" />
      </div>
    </section>
  )}

  <section class="sec sec--dark on-dark" aria-labelledby="que-title">
    <div class="wrap">
      <div class="what">
        <h2 class="h2" id="que-title" data-lines set:html={acento(QUE[c.id] ?? 'Qué es y para *qué se usa.*')} />
        <div class="what__txt" data-rv>
          {c.queEs.map((t) => <p set:html={enlaces(t)} />)}
          <p class="what__links"><a class="link" href="/catalogo">Ver el catálogo completo<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a><a class="link" href="/guias/que-revisar-antes-de-comprar-un-equipo-medico">Qué revisar antes de comprar<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} titulo={`Dudas sobre *${nom.tema}.*`} id={`dudas-${c.id}`} />

  <CtaFinal preset={{ equipo: c.formEquipo, otro: c.formOtro }} />
</Base>
<style is:global>
  .cat-grid { gap: 16px; }
  @media (min-width: 640px) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .cat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; --card-gap: 20px; } }
  /* 4 equipos: 2 × 2 en tableta y 4 en fila en escritorio ancho (sin tarjetas huérfanas) */
  @media (min-width: 1024px) { .cat-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 820px; margin-inline: auto; } }
  @media (min-width: 1200px) { .cat-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: none; } }
  /* 3, 5 y 7 equipos: la última fila incompleta va centrada */
  @media (min-width: 640px) and (max-width: 1023px) {
    .cat-grid:not(.cat-grid--1, .cat-grid--2, .cat-grid--4) > li:last-child:nth-child(odd) { grid-column: 1 / -1; justify-self: center; width: calc(50% - 8px); }
  }
  @media (min-width: 1024px) {
    .cat-grid:not(.cat-grid--1, .cat-grid--2, .cat-grid--4) > li:last-child:nth-child(3n+1) { grid-column: 2; }
    .cat-grid:not(.cat-grid--1, .cat-grid--2, .cat-grid--4) > li:nth-last-child(2):nth-child(3n+1),
    .cat-grid:not(.cat-grid--1, .cat-grid--2, .cat-grid--4) > li:last-child:nth-child(3n+2) { position: relative; left: calc(50% + 10px); }
  }
  .cat-grid--1 { grid-template-columns: minmax(0, 400px) !important; justify-content: center; }
  @media (min-width: 640px) { .cat-grid--2 { grid-template-columns: repeat(2, minmax(0, 380px)) !important; justify-content: center; } }
</style>
