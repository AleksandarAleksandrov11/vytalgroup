---
// Inicio: hero de estudio (titular y tres equipos sobre el mismo suelo), cinta de confianza,
// ecografía en profundidad (sticky), diatermias destacadas, todo tu equipamiento, sin timos +
// comparador, así trabajamos, envíos, catálogo, guías, preguntas frecuentes y el bloque final
// con el formulario.
import '../styles/inicio.css';
import '../styles/cards.css';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import Img from '../components/Img.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SinTimos from '../components/SinTimos.astro';
import Comparator from '../components/Comparator.astro';
import Timeline from '../components/Timeline.astro';
import CatalogMockup from '../components/CatalogMockup.astro';
import GuideCard from '../components/GuideCard.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { CATEGORIAS } from '../data/categorias';
import { producto, urlFicha, altProducto } from '../data/productos';
import { FAQ_GENERAL } from '../data/faqs';
import { EMPRESA } from '../data/empresa';
import { h1Html } from '../lib/texto';
import { escena, recorte } from '../lib/imagenes';
import { faqPage, organization, website } from '../lib/seo';

const ecoPasos = [
  { p: producto('eco-wireless'), t: 'Inalámbrico', d: 'La sonda va contigo y la ecografía se ve en tu móvil, tablet u ordenador, por Wi-Fi o USB-C.' },
  { p: producto('acclarix-ax8'), t: 'Portátil', d: 'Doble pantalla táctil y 128 canales en un formato sellado, pensado para ecoguiados, dolor y deporte.' },
  { p: producto('acclarix-lx9'), t: 'De carro', d: 'Monitor de 21,5″ en brazo articulado y cinco puertos de sonda para una consulta completa.' },
];
const diatermias = ['diatermia-multifuncion', 'reatherm', 'hr-tek'].map(producto);
const resto = CATEGORIAS.filter((c) => !c.pilar);
const guias = (await getCollection('guias')).sort((a, b) => b.data.fecha.localeCompare(a.data.fecha) || a.data.orden - b.data.orden).slice(0, 3);
const titulo = 'Ecógrafos, diatermias y equipos de *fisioterapia.*';
// Equipos del hero: el ecógrafo en el centro y delante (LCP); a los lados, la diatermia de la marca propia y
// unas ondas de choque, algo más atrás. El lienzo de cada foto se recorta a la caja del equipo; los sizes son
// el ancho de ese lienzo en pantalla (ver .hx__stage en inicio.css).
const lados = '(min-width: 1440px) 410px, (min-width: 1024px) 28vw, (min-width: 640px) 45vw, 51vw';
const heroEquipos = [
  { pos: 'l', p: producto('diatermia-multifuncion'), img: 'diatermia-multifuncion-vytamed', sizes: lados, widths: [240, 320, 480, 640, 820] },
  { pos: 'c', p: producto('acclarix-ax8'), img: 'ecografo-portatil-acclarix-ax8-edan', sizes: '(min-width: 1440px) 580px, (min-width: 1024px) 40vw, (min-width: 640px) 63vw, 76vw', widths: [320, 480, 640, 800, 1040, 1280] },
  { pos: 'r', p: producto('shock-med'), img: 'ondas-de-choque-shock-med-eme', sizes: lados, widths: [240, 320, 480, 640, 820] },
];
---
<Base
  title="VytalGroup: ecógrafos, diatermias y equipos de fisioterapia"
  description="Ecógrafos, diatermias y todo el equipamiento de fisioterapia y rehabilitación. Te asesoran fisioterapeutas, con 2 años de garantía y envíos a UE, USA y LATAM."
  path="/"
  og="/og/inicio.jpg"
  seccion="inicio"
  jsonld={[organization(), website(), faqPage(FAQ_GENERAL)]}
>
  <!-- 1 · Hero: fondo claro de estudio, titular centrado y debajo tres equipos reales (diatermia, ecógrafo
       y ondas de choque) apoyados en el mismo suelo, cada uno con su sombra de contacto. Sin efectos: solo
       una entrada suave y, en escritorio, un leve paralaje con el cursor. -->
  <section class="hx" data-hero aria-labelledby="hero-title">
    <div class="wrap hx__wrap">
      <div class="hx__copy">
        <h1 class="h1 hx__title" id="hero-title" set:html={h1Html(titulo)} />
        <p class="hx__lead" data-enter style="--ed:.45s">Equipamiento médico para clínicas y fisioterapeutas, elegido contigo por gente de tu profesión.</p>
        <div class="hx__actions" data-enter style="--ed:.55s">
          <a class="btn btn--primary btn--lg" href="#asesoramiento" data-cta data-magnetic>Quiero asesoramiento</a>
          <a class="btn btn--line btn--lg" href="/catalogo">Ver catálogo<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
      <div class="hx__stage" data-hx-stage>
        {heroEquipos.map((e) => (
          <a class:list={['hx__item', `hx__item--${e.pos}`]} href={urlFicha(e.p)} style={recorte(e.img)}>
            <Img name={e.img} alt={altProducto(e.p)} sizes={e.sizes} widths={e.widths} priority={e.pos === 'c'} class="hx__img" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 · Cinta de confianza -->
  <Marquee />

  <!-- 3 · Ecografía en profundidad (sticky) -->
  <section class="sec sec--mist eco" aria-labelledby="eco-title" data-sticky-eco>
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="eco-title" data-lines>Un ecógrafo para cada <em>forma de trabajar.</em></h2>
      </div>
      <div class="eco__grid">
        <div class="eco__stage" aria-hidden="true">
          <div class="eco__frame">
            {ecoPasos.map((s, i) => (
              <div class:list={['eco__shot', { 'is-active': i === 0 }]} data-shot>
                <Img name={s.p.imagenes[0]} alt={altProducto(s.p)} sizes="(min-width: 900px) 560px, 1px" widths={[480, 640]} />
              </div>
            ))}
            <span class="eco__bars">{ecoPasos.map((_, i) => <span class:list={{ 'is-active': i === 0 }} data-bar></span>)}</span>
          </div>
        </div>
        <ol class="eco__steps">
          {ecoPasos.map((s, i) => (
            <li class:list={['eco__step', { 'is-active': i === 0 }]} data-step>
              <div class="eco__inline" data-rvi><Img name={s.p.imagenes[0]} alt={altProducto(s.p)} sizes="(max-width: 899px) 88vw, 1px" widths={[320, 480, 640]} /></div>
              <p class="eco__kicker">{s.t}</p>
              <h3 class="eco__name">{s.p.nombre} <span>{s.p.marca}</span></h3>
              <p class="eco__txt">{s.d}</p>
              <dl class="eco__data">
                {s.p.datosClave.slice(0, 2).map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
              </dl>
              <a class="link" href={urlFicha(s.p)}>Ver ficha del {s.p.nombre}<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </li>
          ))}
        </ol>
      </div>
      <div class="sec__cta" data-rv>
        <a class="btn btn--dark" href="/ecografos" data-magnetic>Ver todos los ecógrafos<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>

  <!-- 4 · Diatermias destacadas -->
  <section class="sec sec--dots dia" aria-labelledby="dia-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="dia-title" data-lines>Diatermia para cada <em>consulta.</em></h2>
        <div class="seg seg--3" role="tablist" aria-label="Diatermias destacadas" data-seg data-rv>
          <span class="seg__ind" aria-hidden="true"></span>
          {diatermias.map((p, i) => (
            <button class="seg__btn" type="button" role="tab" id={`tab-dia-${i}`} aria-controls={`panel-dia-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}>{p.nombre === 'Diatermia Multifunción' ? 'Multifunción' : p.nombre}</button>
          ))}
        </div>
      </div>
      <div class="panels" data-rv>
        {diatermias.map((p, i) => (
          <div class:list={['panel dia__panel', { 'is-active': i === 0 }]} role="tabpanel" id={`panel-dia-${i}`} aria-labelledby={`tab-dia-${i}`} inert={i !== 0}>
            <div class="dia__media stage" style={escena(p.imagenes[0])}><Img name={p.imagenes[0]} alt={altProducto(p)} sizes="(min-width: 900px) 560px, 92vw" widths={[320, 480, 640]} /></div>
            <div class="dia__body">
              <p class="dia__brand">{p.marca}</p>
              <h3 class="dia__name">{p.nombre}</h3>
              <p class="dia__txt">{p.resumen}</p>
              <dl class="dia__data">
                {p.datosClave.slice(0, 2).map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
              </dl>
              <a class="btn btn--line" href={urlFicha(p)}>Ver ficha<span class="sr-only"> de {p.nombre}</span></a>
            </div>
          </div>
        ))}
      </div>
      <div class="sec__cta" data-rv>
        <a class="btn btn--dark" href="/diatermias" data-magnetic>Ver todas las diatermias<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>

  <!-- 5 · Todo tu equipamiento -->
  <section class="sec sec--photo on-dark more" aria-labelledby="more-title">
    <div class="sec__photo" aria-hidden="true"><Img name="fotos/fondo-sala-tratamiento-fisioterapia" alt="Sala de tratamiento de fisioterapia con camilla eléctrica" sizes="(max-width: 767px) 280vw, (max-width: 1023px) 190vw, 100vw" widths={[640, 1080, 1600]} quality={32} /></div>
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="more-title" data-lines>Más equipos para <em>tu consulta.</em></h2>
      </div>
      <ul class="grid grid--3 more__grid">
        {resto.map((c) => <li><CategoryCard c={c} sizes="(min-width: 1200px) 230px, (min-width: 1024px) 19vw, 46vw" /></li>)}
      </ul>
      <div class="sec__cta" data-rv>
        <a class="btn btn--light" href="/catalogo" data-magnetic>Ver catálogo completo<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </section>

  <!-- 6 · Quién está detrás -->
  <SinTimos />

  <!-- 7 · Lo habitual frente a lo nuestro -->
  <section class="sec vs" aria-labelledby="vs-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="vs-title" data-lines>Lo habitual, <em>y lo nuestro.</em></h2>
      </div>
      <Comparator />
    </div>
  </section>

  <!-- 8 · Así trabajamos -->
  <section class="sec sec--mist" aria-labelledby="tl-title">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="h2" id="tl-title" data-lines>Así <em>trabajamos.</em></h2>
      </div>
      <Timeline />
    </div>
  </section>

  <!-- 9 · Catálogo -->
  <section class="sec sec--dark on-dark cat" aria-labelledby="cat-title">
    <div class="wrap cat__grid">
      <CatalogMockup />
      <div class="cat__copy">
        <h2 class="h2" id="cat-title" data-lines>Todo el catálogo, <em>sin dejar tus datos.</em></h2>
        <p class="lead" data-rv>El catálogo internacional de equipamiento médico 2026, sin precios y de descarga directa.</p>
        <div class="cat__actions" data-rv>
          <a class="btn btn--primary btn--lg" href={EMPRESA.catalogoPdf} download data-catalog data-origen="inicio" data-magnetic><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>Descargar catálogo</a>
          <a class="link" href="/catalogo">O míralo en la web<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 · Guías -->
  {guias.length > 0 && (
    <section class="sec sec--dots guides" aria-labelledby="guias-title">
      <div class="wrap">
        <div class="sec__head">
          <h2 class="h2" id="guias-title" data-lines>Guías para <em>elegir bien.</em></h2>
        </div>
        <ul class="grid grid--3">
          {guias.map((g) => <li><GuideCard g={g} /></li>)}
        </ul>
        <div class="sec__cta" data-rv>
          <a class="btn btn--line" href="/guias">Ver todas las guías</a>
        </div>
      </div>
    </section>
  )}

  <!-- 11 · Preguntas frecuentes -->
  <Faq faqs={FAQ_GENERAL} />

  <!-- 12 · CTA final + formulario -->
  <CtaFinal />
</Base>
